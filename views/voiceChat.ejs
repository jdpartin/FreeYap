<div class="container py-4">
    <div class="row">
    <!-- Main voice interface area -->
    <div class="col-md-8">
      <!-- Topics Display -->
      <div class="topics-display">
        <div class="topics-section user-topics">
          <div class="topics-title">
            <i class="fas fa-user"></i>
            Your Topics
          </div>
          <div class="topics-list" id="user-topics-list">
            <div class="topics-empty">No topics selected</div>
          </div>
        </div>        <div class="topics-section partner-topics">
          <div class="topics-title">
            <i class="fas fa-users"></i>
            <span id="partner-topics-header">Partner's Topics</span>
          </div>
          <div class="topics-list" id="partner-topics-list">
            <div class="topics-empty">Waiting for partner...</div>
          </div>
        </div>
      </div>

      <div class="voice-container bg-light rounded shadow-sm p-4 mb-3 text-center">
        <div class="avatar-display mb-3">          <div class="avatar-circle pulse">
            <i class="bi bi-mic-fill fs-1" style="color: var(--primary);"></i>
          </div>
        </div>
        
        <div class="audio-visualization mb-3">
          <div class="audio-wave">
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
          </div>
        </div>
        
        <p class="lead mb-0">Voice chat is active. Speak freely!</p>
      </div>
      
      <!-- Voice controls -->
      <div class="d-flex justify-content-center flex-wrap gap-2 mb-3">        <button id="startButton" class="btn" style="background-color: var(--primary); color: white;">
          <i class="bi bi-play-fill"></i> Start Looking
        </button>
        <button id="endButton" class="btn btn-danger" disabled>
          <i class="bi bi-telephone-x-fill"></i> End Call
        </button>
        <button id="toggle-mic" class="btn btn-outline-secondary">
          <i class="bi bi-mic-fill"></i> Turn Mic Off
        </button>
        <button id="voiceFilterButton" class="btn btn-outline-secondary" data-bs-toggle="dropdown">
          <i class="bi bi-soundwave"></i> Voice Filter
        </button>
        <div class="dropdown-menu voice-filters-menu p-2">
          <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-sm btn-light voice-filter-btn" data-filter="none">Normal</button>
            <button class="btn btn-sm btn-light voice-filter-btn" data-filter="deep">Deep</button>
            <button class="btn btn-sm btn-light voice-filter-btn" data-filter="high">High Pitch</button>
            <button class="btn btn-sm btn-light voice-filter-btn" data-filter="robot">Robot</button>
          </div>
        </div>
        <button id="soundsButton" class="btn btn-outline-secondary" data-bs-toggle="dropdown">
          <i class="bi bi-music-note-beamed"></i> Sound Effects
        </button>
        <div class="dropdown-menu sounds-menu p-2">
          <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-sm btn-light sound-btn" data-sound="applause">Applause</button>
            <button class="btn btn-sm btn-light sound-btn" data-sound="laugh">Laugh</button>
            <button class="btn btn-sm btn-light sound-btn" data-sound="rimshot">Rimshot</button>
            <button class="btn btn-sm btn-light sound-btn" data-sound="horn">Horn</button>
          </div>
        </div>
      </div>
      
      <div id="statusMessage" class="alert text-center" style="background-color: rgba(255, 77, 109, 0.1); color: var(--primary);"></div>
    </div>
    
    <!-- Chat sidebar -->
    <div class="col-md-4">
      <div class="chat-sidebar">        <div class="card shadow-sm">          <div class="card-header text-white" style="background-color: var(--primary);">
            <span id="chat-session-title">
              <i class="bi bi-chat-dots-fill"></i> Chat
              <i class="bi bi-info-circle ms-2 chat-info-icon" 
                 title="This is a randomly generated name to help you connect personally while staying anonymous" 
                 style="cursor: help; display: none;"></i>
            </span>
          </div>
          <div class="card-body chat-messages" id="chat-messages">
            <p class="text-muted">No messages yet. Start the conversation!</p>
          </div>
          <div class="card-footer p-2">
            <div class="input-group">
              <input type="text" class="form-control" placeholder="Type here..." id="chat-input">              <button class="btn" id="chat-send" style="background-color: var(--primary); color: white;">
                <i class="bi bi-send-fill"></i>
              </button>
            </div>
            <div class="d-flex justify-content-between mt-2">
              <button class="btn btn-sm btn-outline-secondary emoji-button">
                <i class="bi bi-emoji-smile"></i>
              </button>
              <button class="btn btn-sm btn-outline-secondary gif-button">
                <i class="bi bi-filetype-gif"></i>
              </button>
              <button class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-paperclip"></i>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Add Bootstrap Icons -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">

<!-- Include the Socket.IO client library -->
<script src="/socket.io/socket.io.js"></script>

<!-- Include WebRTCClient.js -->
<script src="/WebRTCClient.js"></script>

<!-- Include the SimplePeer library via CDN -->
<script src="https://cdn.jsdelivr.net/npm/simple-peer/simplepeer.min.js"></script>

<!-- Voice chat specific functionality -->
<script>
  // Variable to track delayed matchmaking timeout
  let delayedMatchmakingTimeout = null;
  let matchFound = false;
  
  // Wait for WebRTCClient.js to load and use its socket connection
  document.addEventListener('DOMContentLoaded', async function() {
      // Disable start button initially until permissions are granted
      const startButton = document.getElementById('startButton');
      startButton.disabled = true;
      startButton.textContent = 'Requesting Permissions...';

      try {
          // Request audio permissions immediately for voice chat
          console.log('Voice chat page - requesting audio permissions on load...');
          await initializeMediaStream({ audio: true, video: false });
          
          // Permissions granted - enable start button
          startButton.disabled = false;
          startButton.innerHTML = '<i class="bi bi-play-fill"></i> Start Looking';
          console.log('Audio permissions granted - start button enabled');
      } catch (error) {
          console.error('Failed to get audio permissions:', error);
          startButton.disabled = true;
          startButton.textContent = 'Permissions Required';
          
          // Show error message to user
          const statusMessage = document.getElementById('statusMessage');
          if (statusMessage) {
              statusMessage.className = 'alert alert-danger text-center';
              statusMessage.textContent = 'Audio permissions are required for voice chat. Please refresh and allow microphone access.';
          }
      }

      // Use the socket from WebRTCClient.js instead of creating a new one
      if (typeof window.socket !== 'undefined') {
          // Listen for match-found event to abort delayed matchmaking
          window.socket.on('match-found', () => {
              console.log('Match found! Aborting delayed matchmaking...');
              matchFound = true;
              if (delayedMatchmakingTimeout) {
                  clearTimeout(delayedMatchmakingTimeout);
                  delayedMatchmakingTimeout = null;
                  console.log('Delayed matchmaking timeout cleared');
              }
          });
      } else {
          console.error('Socket not available from WebRTCClient.js');
      }
  });
  document.getElementById('startButton').addEventListener('click', async () =>
  {
      console.log('Start button clicked, joining matchmaking queue...');
      
      // Reset match state
      matchFound = false;
      if (delayedMatchmakingTimeout) {
          clearTimeout(delayedMatchmakingTimeout);
          delayedMatchmakingTimeout = null;
      }

      // Update status message
      const statusMessage = document.getElementById('statusMessage');
      statusMessage.textContent = 'Looking for a chat partner...';

      // Disable the start button to prevent multiple clicks
      const startButton = document.getElementById('startButton');
      startButton.disabled = true;

      try
      {
          // Media stream already initialized on page load, just verify it exists
          if (!localStream) {
              throw new Error('Audio stream not available. Please refresh the page.');
          }
          
          // Extract topics from URL query parameters
          const urlParams = new URLSearchParams(window.location.search);
          const topicsParam = urlParams.get('topics');
          let topics = [];
          
          if (topicsParam) {
              try {
                  topics = JSON.parse(decodeURIComponent(topicsParam));
                  console.log('Extracted topics from URL:', topics);
              } catch (e) {
                  console.error('Error parsing topics from URL:', e);
              }
          }
          
          // Call the join-queue endpoint
          const response = await fetch('/api/matchmaking/join-queue', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ 
                socketId: mySocketId, 
                mode: 'voice', // Specify voice mode
                topics: topics 
              })
          });

          if (!response.ok)
          {
              throw new Error('Failed to join matchmaking queue');
          }

          console.log('Successfully joined matchmaking queue');
          statusMessage.textContent = 'Successfully joined queue. Looking for a match...';

          // Wait for 10 seconds before calling delayed matchmaking
          delayedMatchmakingTimeout = setTimeout(async () =>
          {
              // Check if match was already found
              if (matchFound) {
                  console.log('Match already found, skipping delayed matchmaking');
                  return;
              }

              console.log('10 seconds passed, calling delayed matchmaking...');              try
              {
                  const delayedResponse = await fetch('/api/matchmaking/delayed-matchmaking', {
                      method: 'POST',
                      headers: { 'Content-Type': 'application/json' },
                      body: JSON.stringify({ socketId: mySocketId, topics: topics })
                  });

                  if (!delayedResponse.ok)
                  {
                      throw new Error('Failed to perform delayed matchmaking');
                  }

                  console.log('Successfully called delayed matchmaking');
              }
              catch (error)
              {
                  console.error('Error during delayed matchmaking:', error);
                  statusMessage.textContent = 'Error finding a match. Please try again.';
                  startButton.disabled = false;
              }
          }, 10000);
      }
      catch (error)
      {
          console.error('Error joining matchmaking queue:', error);
          statusMessage.textContent = 'Error joining queue. Please try again.';
          startButton.disabled = false;
      }
  });

  // Initialize WebRTCClient for voice chat
  document.addEventListener('DOMContentLoaded', function()
  {
      const endButton = document.getElementById('endButton');
      const toggleMicButton = document.getElementById('toggle-mic');
      const chatInput = document.getElementById('chat-input');
      const chatSend = document.getElementById('chat-send');
      const chatMessages = document.getElementById('chat-messages');
      const audioWave = document.querySelector('.audio-wave');
      
      // Setup audio element for remote stream
      const remoteAudio = new Audio();
      remoteAudio.autoplay = true;
      
      let isMuted = false;
      
      // Initialize chat functionality
      chatSend.addEventListener('click', () => {
          sendChatMessage();
      });
      
      chatInput.addEventListener('keypress', (event) => {
          if (event.key === 'Enter') {
              event.preventDefault();
              sendChatMessage();
          }
      });
      
      function sendChatMessage() {
          const message = chatInput.value.trim();
          if (message && peer && peer.connected) {
              try {
                  peer.send(JSON.stringify({
                      type: 'chat',
                      content: message
                  }));
                  appendChatMessage('You', message);
                  chatInput.value = '';
              } catch (err) {
                  console.error('Error sending message:', err);
              }
          }
      }
      
      function appendChatMessage(sender, content) {
          const messageElem = document.createElement('div');
          messageElem.className = sender === 'You' ? 'message message-sent' : 'message message-received';
          messageElem.innerHTML = `<strong>${sender}:</strong> ${content}`;
          
          // Remove "no messages" placeholder if it exists
          const placeholder = chatMessages.querySelector('.text-muted');
          if (placeholder) {
              chatMessages.innerHTML = '';
          }
          
          chatMessages.appendChild(messageElem);
          chatMessages.scrollTop = chatMessages.scrollHeight;
      }
      
      // End call handler
      endButton.addEventListener('click', () => {
          endCurrentCall();
      });
      
      // Toggle mic handler
      toggleMicButton.addEventListener('click', () => {
          if (localStream) {
              const audioTracks = localStream.getAudioTracks();
              if (audioTracks.length > 0) {
                  const enabled = !audioTracks[0].enabled;
                  audioTracks[0].enabled = enabled;
                  isMuted = !enabled;
                  
                  toggleMicButton.innerHTML = isMuted ? 
                      '<i class="bi bi-mic-mute-fill"></i> Turn Mic On' : 
                      '<i class="bi bi-mic-fill"></i> Turn Mic Off';
                  
                  toggleMicButton.classList.toggle('btn-outline-secondary', !isMuted);
                  toggleMicButton.classList.toggle('btn-secondary', isMuted);
                  
                  // Toggle audio visualization when muted
                  if (isMuted) {
                      audioWave.classList.remove('active');
                  } else if (peer && peer.connected) {
                      audioWave.classList.add('active');
                  }
              }
          }
      });
      
      // Sound effects functionality
      const soundButtons = document.querySelectorAll('.sound-btn');
      soundButtons.forEach(btn => {
          btn.addEventListener('click', () => {
              const soundType = btn.getAttribute('data-sound');
              if (peer && peer.connected) {
                  peer.send(JSON.stringify({
                      type: 'sound',
                      sound: soundType
                  }));
                  playSoundEffect(soundType);
              }
          });
      });
      
      function playSoundEffect(soundType) {
          // Implement sound effects playback
          console.log(`Playing sound effect: ${soundType}`);
          // This would be implemented with actual audio files
      }
      
      // Voice filter functionality
      const filterButtons = document.querySelectorAll('.voice-filter-btn');
      filterButtons.forEach(btn => {
          btn.addEventListener('click', () => {
              const filterType = btn.getAttribute('data-filter');
              console.log(`Setting voice filter: ${filterType}`);
              // This would be implemented with Web Audio API
          });
      });
      
      // Setup enhanced WebRTCClient for voice chat
      function setupPeerExtensions(peer) {
          // Existing peer setup
          
          // Add data channel handling for chat and effects
          peer.on('data', data => {
              try {
                  const message = JSON.parse(data.toString());
                    if (message.type === 'chat') {
                      appendChatMessage(window.getPartnerName ? window.getPartnerName() : 'Partner', message.content);
                  } else if (message.type === 'sound') {
                      playSoundEffect(message.sound);
                  }
              } catch (err) {
                  console.error('Error processing message:', err);
              }
          });
          
          // Add stream handling
          peer.on('stream', stream => {
              console.log('Received remote stream');
              
              // Set the remote audio stream
              remoteAudio.srcObject = stream;
              
              // Enable UI elements for active call
              endButton.disabled = false;
              chatInput.disabled = false;
              chatSend.disabled = false;
              document.getElementById('statusMessage').textContent = 'Connected! Voice chat session started.';
              
              // Start audio visualization
              audioWave.classList.add('active');
          });
          
          peer.on('close', () => {
              console.log('Peer connection closed');
              endCurrentCall();
          });
          
          peer.on('error', err => {
              console.error('Peer connection error:', err);
              endCurrentCall();
          });
      }
      
      function endCurrentCall() {
          const statusMessage = document.getElementById('statusMessage');
          const startButton = document.getElementById('startButton');
          
          // Stop the local stream
          if (localStream) {
              localStream.getTracks().forEach(track => track.stop());
          }
          
          // Stop audio visualization
          audioWave.classList.remove('active');
          
          // Reset UI state
          endButton.disabled = true;
          chatInput.disabled = true;
          chatSend.disabled = true;
          startButton.disabled = false;
          statusMessage.textContent = '';
          chatMessages.innerHTML = '<p class="text-muted">No messages yet. Start the conversation!</p>';
          
          // Reset WebRTC state
          if (peer) {
              peer.destroy();
              peer = null;
          }
          partnerSocketId = null;
      }
      
      // Extend the original WebRTCClient's setupPeer function
      const originalSetupPeer = setupPeer;
      
      // Override the setupPeer function
      window.setupPeer = function(p, toSocketId) {
          originalSetupPeer(p, toSocketId);
          setupPeerExtensions(p);
          return p;
      };
  });
  // Voice chat will use the initializeMediaStream from WebRTCClient.js
  // No need for a separate implementation
</script>
