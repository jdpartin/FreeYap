<link href="/css/index-page.css" rel="stylesheet">
<!-- Spell Checker CSS - only for home page -->
<link rel="stylesheet" href="/css/spellcheck.css">

<div class="widget-container">  
  <div class="widget-header">
    <div class="logo-section">
      <div class="logo-brand-row">
        <i class="icon-logo me-2" style="font-size:1.7em;color:white;"></i>
        <span class="brand-text">FreeYap.com</span>
      </div>
      <p>Chat with strangers, be treated like an adult.</p>
    </div>
    <div class="status-indicator">
      <i class="fas fa-circle me-2" style="color: #4ade80;"></i>
      Ready to Connect
    </div>
  </div>

  <div class="widget-content">    
    <div class="topic-input-widget-compact">
      <p class="text-muted small mb-2">Add topics for better matches (optional)</p>
      <div class="input-group topic-input-widget">
        <span class="input-group-text border-0" id="basic-addon1" style="background: transparent;">
          <i class="fas fa-tag"></i>
        </span>
        <input type="text" id="topicInput" class="form-control border-0" placeholder="What would you like to talk about?" style="background: transparent;">
        <button id="addTopicBtn" class="btn border-0 d-none" type="button" style="background-color: var(--primary); color: white;">
          <i class="fas fa-plus"></i>
        </button>
      </div>
    </div>

    <div id="topicList" class="mb-4"></div>

    <div class="chat-interface-grid">
      <a href="/video-chat" class="chat-interface-card">
        <div class="icon-circle">
          <i class="fas fa-video"></i>
        </div>
        <h4>Video Chat</h4>
      </a>      
      
      <a href="/voice-chat" class="chat-interface-card">
        <div class="icon-circle">
          <i class="fas fa-microphone"></i>
        </div>
        <h4>Voice Chat</h4>
      </a>

      <a href="/text-chat" class="chat-interface-card">
        <div class="icon-circle">
          <i class="fas fa-comment-dots"></i>
        </div>
        <h4>Text Chat</h4>
      </a>
    </div>

    <div class="game-link-section mt-3 mb-3" style="display:none;">
      <a href="/findGames" class="game-link">
        <i class="fas fa-gamepad me-2"></i>
        Play a Game with a Stranger
      </a>
    </div>    <div class="popular-topics-section">
      <div class="popular-topics-title fw-bold mb-2" style="font-size: 0.9rem; color: var(--primary);">
        <i class="fas fa-star me-1"></i> Popular Topics
      </div>
      <div id="popularTopics" class="popular-topics-content small" style="font-size: 0.8rem; color: var(--primary);">
        <i class="fas fa-spinner fa-spin me-2"></i>Loading popular topics...
      </div>
    </div>

    <div class="info-panel-compact">
      <p class="small mb-1"><strong>18+ only.</strong> Anonymous, safe, respectful.</p>
      <p class="small mb-0">
        <a href="/terms" style="color: var(--primary); text-decoration: none;">Terms</a> • 
        <a href="/privacy" style="color: var(--primary); text-decoration: none;">Privacy</a>
      </p>
    </div>  </div>
</div>

<!-- Vibe Check Overlay -->
<div id="vibeOverlay" class="vibe-overlay hidden">
  <div class="vibe-overlay-backdrop"></div>
  <%- include('components/vibe-form') %>
</div>

<!-- Spell checker scripts - only for home page -->
<script src="https://cdn.jsdelivr.net/npm/typo-js@1.2.5/typo.js"></script>
<script src="/js/typo.js"></script>
<script src="/js/spellcheck.js"></script>
<script src="/js/index-page.js" defer></script>