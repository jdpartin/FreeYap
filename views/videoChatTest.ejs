<!-- Include the SimplePeer library via CDN -->
<script src="https://cdn.jsdelivr.net/npm/simple-peer/simplepeer.min.js"></script>

<script src="/socket.io/socket.io.js"></script>
<script src="/js/webRTC/WebRTCConnectionManager.js"></script>
<script src="/js/apiClients/matchmakingAPIClient.js"></script>
<script src="/js/modules/videoChat.js"></script>

<div class="container">
    <h1>Video Chat Test</h1>
    
    <div id="video-container">        <div id="video-controls">
            <button id="test-camera-btn" class="btn" style="background-color: #007bff; display: none;">Test Camera (Fallback)</button>
            <button id="start-video-btn" class="btn" disabled>Start Video Chat</button>
            <button id="stop-video-btn" class="btn" disabled>Stop Video</button>
            <button id="mute-video-btn" class="btn" disabled>Mute Video</button>
            <button id="mute-audio-btn" class="btn" disabled>Mute Audio</button>
        </div>
        
        <div id="videos">
            <div class="video-wrapper">
                <label>Local Video</label>
                <video id="local-video" autoplay muted></video>
            </div>
            <div class="video-wrapper">
                <label>Remote Video</label>
                <video id="remote-video" autoplay></video>
            </div>
        </div>        <div id="connection-status">
            Status: Initializing camera and microphone permissions...
        </div>
    </div>
</div>

<style>
    #video-container {
        margin: 20px auto;
        max-width: 1200px;
    }
    
    #video-controls {
        margin-bottom: 15px;
    }
    
    .btn {
        padding: 8px 16px;
        margin-right: 10px;
        background-color: #4CAF50;
        color: white;
        border: none;
        border-radius: 4px;
        cursor: pointer;
    }
    
    .btn:disabled {
        background-color: #cccccc;
        cursor: not-allowed;
    }
    
    #videos {
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 20px;
    }
    
    .video-wrapper {
        flex: 1;
        min-width: 320px;
        text-align: center;
    }
    
    video {
        width: 100%;
        max-width: 640px;
        height: auto;
        background-color: #222;
        border: 1px solid #444;
    }
    
    #connection-status {
        margin-top: 15px;
        padding: 10px;
        background-color: #f8f9fa;
        border-radius: 4px;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', async () => {
        // Get UI elements first
        const localVideo = document.getElementById('local-video');
        const remoteVideo = document.getElementById('remote-video');
        const testCameraBtn = document.getElementById('test-camera-btn');
        const startVideoBtn = document.getElementById('start-video-btn');
        const stopVideoBtn = document.getElementById('stop-video-btn');
        const muteVideoBtn = document.getElementById('mute-video-btn');
        const muteAudioBtn = document.getElementById('mute-audio-btn');
        const connectionStatus = document.getElementById('connection-status');
        
        let videoChat;
        let isVideoMuted = false;
        let isAudioMuted = false;
        let localStream = null;
        let isInQueue = false;
        
        // Check browser capabilities and permissions status
        console.log('Browser capabilities check:');
        console.log('- getUserMedia available:', !!navigator.mediaDevices?.getUserMedia);
        console.log('- enumerateDevices available:', !!navigator.mediaDevices?.enumerateDevices);
        
        // Auto-start camera and microphone permissions verification
        async function initializeMediaAndQueue() {
            try {
                connectionStatus.textContent = 'Status: Requesting camera and microphone permissions...';
                console.log('Auto-requesting camera and microphone permissions...');
                
                // Check available devices first
                const devices = await navigator.mediaDevices.enumerateDevices();
                const videoDevices = devices.filter(device => device.kind === 'videoinput');
                const audioDevices = devices.filter(device => device.kind === 'audioinput');
                
                console.log('Available video devices:', videoDevices);
                console.log('Available audio devices:', audioDevices);
                
                if (videoDevices.length === 0) {
                    connectionStatus.textContent = 'Status: No cameras detected on your device';
                    console.error('No video input devices found');
                    return false;
                }
                
                if (audioDevices.length === 0) {
                    connectionStatus.textContent = 'Status: No microphones detected on your device';
                    console.error('No audio input devices found');
                    return false;
                }
                
                // Request permissions and get media stream
                localStream = await navigator.mediaDevices.getUserMedia({ 
                    video: {
                        width: { ideal: 640 },
                        height: { ideal: 480 }
                    },
                    audio: true 
                });
                
                // Display the stream in local video
                localVideo.srcObject = localStream;
                connectionStatus.textContent = 'Status: Camera and microphone access granted! Connecting to queue...';
                
                // Hide the test camera button since we now have automatic access
                testCameraBtn.style.display = 'none';
                
                // Enable the video controls
                muteVideoBtn.disabled = false;
                muteAudioBtn.disabled = false;
                stopVideoBtn.disabled = false;
                
                console.log('Media permissions granted successfully');
                return true;
                
            } catch (error) {
                console.error('Media access error:', error);
                
                // Provide specific error messages
                if (error.name === 'NotAllowedError') {
                    connectionStatus.textContent = 'Status: Camera/microphone access denied. Please allow access and refresh the page.';
                } else if (error.name === 'NotFoundError') {
                    connectionStatus.textContent = 'Status: No camera or microphone found. Please connect devices and refresh.';
                } else if (error.name === 'NotReadableError') {
                    connectionStatus.textContent = 'Status: Camera/microphone in use by another application. Please close other apps.';
                } else {
                    connectionStatus.textContent = `Status: Failed to access media - ${error.message}`;
                }
                
                // Show the test camera button as fallback
                testCameraBtn.style.display = 'inline-block';
                return false;
            }
        }
        
        // Initialize socket and matchmaking after media is ready
        async function initializeSocketAndMatchmaking() {
            try {
                const socket = io();
                const matchmakingClient = new MatchmakingAPIClient();
                
                // Wait for socket connection
                await new Promise((resolve) => {
                    socket.on('connect', resolve);
                });
                
                const socketId = socket.id;
                const mode = 'video';
                
                // Join the matchmaking queue immediately
                await matchmakingClient.joinQueue(socketId, mode);
                connectionStatus.textContent = 'Status: Connected to queue! Searching for a match...';
                isInQueue = true;
                
                console.log('Joined matchmaking queue automatically');
                
                // Set a timeout for delayed matchmaking
                const matchmakingTimeout = setTimeout(async () => {
                    connectionStatus.textContent = 'Status: No match found quickly, trying delayed matchmaking...';
                    console.log('No match found within 10 seconds. Initiating delayed matchmaking...');
                    await matchmakingClient.delayedMatchmaking(socketId, mode);
                }, 10000);
                
                // Listen for match-found event
                socket.on('match-found', ({ socketId, matchedSocketId, isInitiator }) => {
                    console.log(`Match found! Matched with: ${matchedSocketId}, Initiator: ${isInitiator}`);
                    connectionStatus.textContent = 'Status: Match found! Setting up connection...';
                    
                    // Clear the matchmaking timeout if a match is found
                    clearTimeout(matchmakingTimeout);
                    
                    const webRTCManager = new WebRTCConnectionManager(socket);
                    
                    if (isInitiator) {
                        // Initiate connection as the initiator
                        webRTCManager.connectToPeer(matchedSocketId);
                        connectionStatus.textContent = 'Status: Connecting to peer as initiator...';
                    } else {
                        // Wait for signaling from the initiator
                        console.log('Waiting for initiator to connect...');
                        connectionStatus.textContent = 'Status: Waiting for initiator to connect...';
                    }
                    
                    // Initialize VideoChat
                    videoChat = new VideoChat(webRTCManager);
                    
                    // Set up event handlers for connection status
                    webRTCManager.on('connectionReady', async () => {
                        connectionStatus.textContent = 'Status: Connection established! Starting video automatically...';
                        
                        // Automatically start video when connected
                        try {
                            const success = await videoChat.startVideo();
                            if (success) {
                                connectionStatus.textContent = 'Status: Video chat active!';
                                startVideoBtn.disabled = true;
                            } else {
                                connectionStatus.textContent = 'Status: Connection ready, click "Start Video Chat" to begin';
                                startVideoBtn.disabled = false;
                            }
                        } catch (error) {
                            console.error('Auto-start video error:', error);
                            connectionStatus.textContent = 'Status: Connection ready, click "Start Video Chat" to begin';
                            startVideoBtn.disabled = false;
                        }
                    });
                    
                    webRTCManager.on('connectionClosed', () => {
                        connectionStatus.textContent = 'Status: Connection closed';
                        disableControls();
                    });
                    
                    webRTCManager.on('connectionError', (error) => {
                        connectionStatus.textContent = `Status: Connection error - ${error.message}`;
                        disableControls();
                    });
                    
                    // Handle local stream
                    videoChat.on('localStream', (event) => {
                        const { stream } = event.detail;
                        localVideo.srcObject = stream;
                        
                        // Enable control buttons
                        stopVideoBtn.disabled = false;
                        muteVideoBtn.disabled = false;
                        muteAudioBtn.disabled = false;
                        startVideoBtn.disabled = true;
                    });
                    
                    // Handle remote stream
                    videoChat.on('remoteStream', (event) => {
                        const { stream } = event.detail;
                        remoteVideo.srcObject = stream;
                        connectionStatus.textContent = 'Status: Remote video connected!';
                    });
                    
                    // Handle video mute events
                    videoChat.on('videoMuted', (event) => {
                        const { value } = event.detail;
                        connectionStatus.textContent = `Status: Peer has ${value ? 'muted' : 'unmuted'} their video`;
                    });
                    
                    // Handle audio mute events
                    videoChat.on('audioMuted', (event) => {
                        const { value } = event.detail;
                        connectionStatus.textContent = `Status: Peer has ${value ? 'muted' : 'unmuted'} their audio`;
                    });
                    
                    // Handle video request events
                    videoChat.on('videoRequest', (event) => {
                        const { value } = event.detail;
                        if (value) {
                            connectionStatus.textContent = 'Status: Peer requested to start video';
                        } else {
                            connectionStatus.textContent = 'Status: Peer stopped their video';
                        }
                    });
                });
                
                return { socket, matchmakingClient };
            } catch (error) {
                console.error('Socket/matchmaking error:', error);
                connectionStatus.textContent = `Status: Connection error - ${error.message}`;
                return null;
            }
        }

        // Auto-initialize everything on page load
        const mediaSuccess = await initializeMediaAndQueue();
        if (mediaSuccess) {
            await initializeSocketAndMatchmaking();
        }
        
        // Log permission status if available (for debugging)
        if (navigator.permissions && navigator.permissions.query) {
            try {
                const cameraPermission = await navigator.permissions.query({ name: 'camera' });
                console.log('Camera permission status:', cameraPermission.state);
                
                const micPermission = await navigator.permissions.query({ name: 'microphone' });
                console.log('Microphone permission status:', micPermission.state);
            } catch (err) {
                console.log('Permission query not supported:', err);
            }
        }

        // Fallback: Test Camera button function (for when auto-init fails)
        async function testCamera() {
            try {
                connectionStatus.textContent = 'Status: Requesting camera and microphone permissions...';
                console.log('Manual testing camera access...');
                
                // Display available media devices
                const devices = await navigator.mediaDevices.enumerateDevices();
                const videoDevices = devices.filter(device => device.kind === 'videoinput');
                console.log('Available video devices:', videoDevices);
                
                if (videoDevices.length === 0) {
                    connectionStatus.textContent = 'Status: No cameras detected on your device';
                    console.error('No video input devices found');
                    return;
                }
                
                // Stop existing stream if any
                if (localStream) {
                    localStream.getTracks().forEach(track => track.stop());
                }
                
                // Request permissions and get media stream
                localStream = await navigator.mediaDevices.getUserMedia({ 
                    video: {
                        width: { ideal: 640 },
                        height: { ideal: 480 }
                    },
                    audio: true 
                });
                
                // Display the stream in local video
                localVideo.srcObject = localStream;
                connectionStatus.textContent = 'Status: Camera test successful! Attempting to join queue...';
                
                // Update button states
                testCameraBtn.textContent = 'Stop Camera Test';
                testCameraBtn.style.backgroundColor = '#dc3545'; // Red color
                testCameraBtn.onclick = stopCameraTest;
                
                // Try to initialize matchmaking if not already in queue
                if (!isInQueue) {
                    await initializeSocketAndMatchmaking();
                }
                
            } catch (error) {
                console.error('Camera test error:', error);
                connectionStatus.textContent = `Status: Failed to access camera - ${error.message}`;
                
                // Add specific error messages
                if (error.name === 'NotAllowedError') {
                    connectionStatus.textContent = 'Status: Camera access denied. Please allow camera access in your browser settings and try again.';
                } else if (error.name === 'NotFoundError') {
                    connectionStatus.textContent = 'Status: No camera found. Please connect a camera and try again.';
                } else if (error.name === 'NotReadableError') {
                    connectionStatus.textContent = 'Status: Camera is in use by another application. Please close other apps using your camera.';
                }
            }
        }

        function stopCameraTest() {
            if (localStream) {
                localStream.getTracks().forEach(track => track.stop());
                localStream = null;
                localVideo.srcObject = null;
            }
            
            connectionStatus.textContent = 'Status: Camera test stopped';
            testCameraBtn.textContent = 'Test Camera';
            testCameraBtn.style.backgroundColor = '#007bff'; // Blue color
            testCameraBtn.onclick = testCamera;
        }

        // Set up test camera button (fallback)
        testCameraBtn.addEventListener('click', testCamera);        // Button event handlers
        startVideoBtn.addEventListener('click', async () => {
            if (!videoChat) {
                connectionStatus.textContent = 'Status: Please wait for connection to be established';
                return;
            }
            
            try {
                connectionStatus.textContent = 'Status: Starting video chat...';
                console.log('Starting video chat with WebRTC...');
                
                const success = await videoChat.startVideo();
                
                if (success) {
                    connectionStatus.textContent = 'Status: Video started';
                    startVideoBtn.disabled = true;
                } else {
                    connectionStatus.textContent = 'Status: Failed to start WebRTC video';
                }
            } catch (error) {
                console.error('Video start error:', error);
                connectionStatus.textContent = `Status: Failed to start video - ${error.message}`;
            }
        });
        
        stopVideoBtn.addEventListener('click', () => {
            if (localStream) {
                localStream.getTracks().forEach(track => track.stop());
                localStream = null;
                localVideo.srcObject = null;
            }
            
            if (videoChat) {
                const success = videoChat.stopVideo();
                if (success) {
                    connectionStatus.textContent = 'Status: Video stopped';
                    disableVideoControls();
                }
            } else {
                connectionStatus.textContent = 'Status: Video stopped';
                disableVideoControls();
            }
        });
        
        muteVideoBtn.addEventListener('click', () => {
            if (!videoChat && localStream) {
                // Handle muting for local stream
                const videoTrack = localStream.getVideoTracks()[0];
                if (videoTrack) {
                    isVideoMuted = !isVideoMuted;
                    videoTrack.enabled = !isVideoMuted;
                    muteVideoBtn.textContent = isVideoMuted ? 'Unmute Video' : 'Mute Video';
                    connectionStatus.textContent = `Status: Video ${isVideoMuted ? 'muted' : 'unmuted'}`;
                }
                return;
            }
            
            if (!videoChat) return;
            
            isVideoMuted = !isVideoMuted;
            const success = videoChat.toggleVideo(isVideoMuted);
            
            if (success) {
                muteVideoBtn.textContent = isVideoMuted ? 'Unmute Video' : 'Mute Video';
                connectionStatus.textContent = `Status: Video ${isVideoMuted ? 'muted' : 'unmuted'}`;
            }
        });
        
        muteAudioBtn.addEventListener('click', () => {
            if (!videoChat && localStream) {
                // Handle muting for local stream
                const audioTrack = localStream.getAudioTracks()[0];
                if (audioTrack) {
                    isAudioMuted = !isAudioMuted;
                    audioTrack.enabled = !isAudioMuted;
                    muteAudioBtn.textContent = isAudioMuted ? 'Unmute Audio' : 'Mute Audio';
                    connectionStatus.textContent = `Status: Audio ${isAudioMuted ? 'muted' : 'unmuted'}`;
                }
                return;
            }
            
            if (!videoChat) return;
            
            isAudioMuted = !isAudioMuted;
            const success = videoChat.toggleAudio(isAudioMuted);
            
            if (success) {
                muteAudioBtn.textContent = isAudioMuted ? 'Unmute Audio' : 'Mute Audio';
                connectionStatus.textContent = `Status: Audio ${isAudioMuted ? 'muted' : 'unmuted'}`;
            }
        });
        
        function disableControls() {
            startVideoBtn.disabled = true;
            stopVideoBtn.disabled = true;
            muteVideoBtn.disabled = true;
            muteAudioBtn.disabled = true;
        }
        
        function disableVideoControls() {
            startVideoBtn.disabled = false;
            stopVideoBtn.disabled = true;
            muteVideoBtn.disabled = true;
            muteAudioBtn.disabled = true;
        }
    });
</script>
