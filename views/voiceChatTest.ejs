<!-- Include the SimplePeer library via CDN -->
<script src="https://cdn.jsdelivr.net/npm/simple-peer/simplepeer.min.js"></script>

<script src="/socket.io/socket.io.js"></script>
<script src="/js/webRTC/WebRTCConnectionManager.js"></script>
<script src="/js/apiClients/matchmakingAPIClient.js"></script>
<script src="/js/modules/voiceChat.js"></script>

<div class="container">
    <h1>Voice Chat Test</h1>
    
    <div id="voice-container">
        <div id="voice-controls">
            <button id="test-mic-btn" class="btn" style="background-color: #007bff; display: none;">Test Microphone (Fallback)</button>
            <button id="start-voice-btn" class="btn" disabled>Start Voice Chat</button>
            <button id="stop-voice-btn" class="btn" disabled>Stop Voice</button>
            <button id="mute-audio-btn" class="btn" disabled>Mute Audio</button>
            <button id="voice-effect-btn" class="btn" disabled>Voice Effect</button>
        </div>
        
        <div id="audio-visualizer">
            <div class="audio-wrapper">
                <label>Local Audio</label>
                <audio id="local-audio" autoplay muted></audio>
                <div class="audio-wave local-wave" id="local-wave">
                    <div class="wave-bar"></div>
                    <div class="wave-bar"></div>
                    <div class="wave-bar"></div>
                    <div class="wave-bar"></div>
                    <div class="wave-bar"></div>
                </div>
            </div>
            <div class="audio-wrapper">
                <label>Remote Audio</label>
                <audio id="remote-audio" autoplay></audio>
                <div class="audio-wave remote-wave" id="remote-wave">
                    <div class="wave-bar"></div>
                    <div class="wave-bar"></div>
                    <div class="wave-bar"></div>
                    <div class="wave-bar"></div>
                    <div class="wave-bar"></div>
                </div>
            </div>
        </div>

        <div id="connection-status">
            Status: Initializing microphone permissions...
        </div>
    </div>
</div>

<style>
    #voice-container {
        margin: 20px auto;
        max-width: 800px;
        text-align: center;
    }
    
    #voice-controls {
        margin-bottom: 30px;
    }
    
    .btn {
        padding: 10px 20px;
        margin: 0 10px 10px 0;
        background-color: #4CAF50;
        color: white;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-size: 14px;
        font-weight: 500;
    }
    
    .btn:disabled {
        background-color: #cccccc;
        cursor: not-allowed;
    }
    
    .btn:hover:not(:disabled) {
        background-color: #45a049;
    }
    
    #audio-visualizer {
        display: flex;
        justify-content: space-around;
        flex-wrap: wrap;
        gap: 40px;
        margin: 30px 0;
    }
    
    .audio-wrapper {
        flex: 1;
        min-width: 250px;
        text-align: center;
    }
    
    .audio-wrapper label {
        display: block;
        font-weight: bold;
        margin-bottom: 15px;
        color: #333;
    }
    
    audio {
        width: 100%;
        max-width: 300px;
        margin-bottom: 20px;
    }
    
    .audio-wave {
        display: flex;
        justify-content: center;
        align-items: end;
        height: 60px;
        gap: 4px;
        margin: 0 auto;
        width: 100px;
    }
    
    .wave-bar {
        width: 8px;
        min-height: 4px;
        background: linear-gradient(to top, #4CAF50, #81C784);
        border-radius: 4px;
        animation: wave 1.5s ease-in-out infinite;
    }
    
    .wave-bar:nth-child(1) { animation-delay: 0s; }
    .wave-bar:nth-child(2) { animation-delay: 0.1s; }
    .wave-bar:nth-child(3) { animation-delay: 0.2s; }
    .wave-bar:nth-child(4) { animation-delay: 0.3s; }
    .wave-bar:nth-child(5) { animation-delay: 0.4s; }
    
    @keyframes wave {
        0%, 100% { height: 8px; }
        50% { height: 40px; }
    }
    
    .audio-wave.active .wave-bar {
        background: linear-gradient(to top, #FF5722, #FF8A65);
    }
    
    .audio-wave.muted .wave-bar {
        background: linear-gradient(to top, #666, #999);
        animation-play-state: paused;
    }
    
    #connection-status {
        margin-top: 25px;
        padding: 15px;
        background-color: #f8f9fa;
        border-radius: 6px;
        border-left: 4px solid #4CAF50;
        font-weight: 500;
    }
    
    #voice-effect-btn {
        background-color: #9C27B0;
    }
    
    #voice-effect-btn:hover:not(:disabled) {
        background-color: #7B1FA2;
    }
    
    #mute-audio-btn.muted {
        background-color: #F44336;
    }
    
    #mute-audio-btn.muted:hover {
        background-color: #D32F2F;
    }
    
    @media (max-width: 600px) {
        #audio-visualizer {
            flex-direction: column;
            gap: 20px;
        }
        
        .btn {
            display: block;
            width: 100%;
            margin: 5px 0;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', async () => {
        // Get UI elements first
        const localAudio = document.getElementById('local-audio');
        const remoteAudio = document.getElementById('remote-audio');
        const testMicBtn = document.getElementById('test-mic-btn');
        const startVoiceBtn = document.getElementById('start-voice-btn');
        const stopVoiceBtn = document.getElementById('stop-voice-btn');
        const muteAudioBtn = document.getElementById('mute-audio-btn');
        const voiceEffectBtn = document.getElementById('voice-effect-btn');
        const connectionStatus = document.getElementById('connection-status');
        const localWave = document.getElementById('local-wave');
        const remoteWave = document.getElementById('remote-wave');
        
        let voiceChat;
        let isAudioMuted = false;
        let localStream = null;
        let isInQueue = false;
        let currentVoiceEffect = 'none';
        
        // Check browser capabilities and permissions status
        console.log('Browser capabilities check:');
        console.log('- getUserMedia available:', !!navigator.mediaDevices?.getUserMedia);
        console.log('- enumerateDevices available:', !!navigator.mediaDevices?.enumerateDevices);
        
        // Auto-start microphone permissions verification
        async function initializeMediaAndQueue() {
            try {
                connectionStatus.textContent = 'Status: Requesting microphone permissions...';
                console.log('Auto-requesting microphone permissions...');
                
                // Check available devices first
                const devices = await navigator.mediaDevices.enumerateDevices();
                const audioDevices = devices.filter(device => device.kind === 'audioinput');
                
                console.log('Available audio devices:', audioDevices);
                
                if (audioDevices.length === 0) {
                    connectionStatus.textContent = 'Status: No microphones detected on your device';
                    console.error('No audio input devices found');
                    return false;
                }
                
                // Request permissions and get media stream (audio only)
                localStream = await navigator.mediaDevices.getUserMedia({ 
                    video: false,
                    audio: {
                        echoCancellation: true,
                        noiseSuppression: true,
                        autoGainControl: true,
                        sampleRate: 44100
                    }
                });
                
                // Display the stream in local audio
                localAudio.srcObject = localStream;
                connectionStatus.textContent = 'Status: Microphone access granted! Connecting to queue...';
                
                // Activate local audio visualization
                localWave.classList.add('active');
                
                // Hide the test microphone button since we now have automatic access
                testMicBtn.style.display = 'none';
                
                // Enable the voice controls
                muteAudioBtn.disabled = false;
                stopVoiceBtn.disabled = false;
                voiceEffectBtn.disabled = false;
                
                console.log('Media permissions granted successfully');
                return true;
                
            } catch (error) {
                console.error('Media access error:', error);
                
                // Provide specific error messages
                if (error.name === 'NotAllowedError') {
                    connectionStatus.textContent = 'Status: Microphone access denied. Please allow access and refresh the page.';
                } else if (error.name === 'NotFoundError') {
                    connectionStatus.textContent = 'Status: No microphone found. Please connect a microphone and refresh.';
                } else if (error.name === 'NotReadableError') {
                    connectionStatus.textContent = 'Status: Microphone in use by another application. Please close other apps.';
                } else {
                    connectionStatus.textContent = `Status: Failed to access media - ${error.message}`;
                }
                
                // Show the test microphone button as fallback
                testMicBtn.style.display = 'inline-block';
                return false;
            }
        }
        
        // Initialize socket and matchmaking after media is ready
        async function initializeSocketAndMatchmaking() {
            try {
                const socket = io();
                const matchmakingClient = new MatchmakingAPIClient();
                
                // Wait for socket connection
                await new Promise((resolve) => {
                    socket.on('connect', resolve);
                });
                
                const socketId = socket.id;
                const mode = 'voice';
                
                // Join the matchmaking queue immediately
                await matchmakingClient.joinQueue(socketId, mode);
                connectionStatus.textContent = 'Status: Connected to queue! Searching for a match...';
                isInQueue = true;
                
                console.log('Joined matchmaking queue automatically');
                
                // Set a timeout for delayed matchmaking
                const matchmakingTimeout = setTimeout(async () => {
                    connectionStatus.textContent = 'Status: No match found quickly, trying delayed matchmaking...';
                    console.log('No match found within 10 seconds. Initiating delayed matchmaking...');
                    await matchmakingClient.delayedMatchmaking(socketId, mode);
                }, 10000);
                
                // Listen for match-found event
                socket.on('match-found', ({ socketId, matchedSocketId, isInitiator }) => {
                    console.log(`Match found! Matched with: ${matchedSocketId}, Initiator: ${isInitiator}`);
                    connectionStatus.textContent = 'Status: Match found! Setting up connection...';
                    
                    // Clear the matchmaking timeout if a match is found
                    clearTimeout(matchmakingTimeout);
                    
                    const webRTCManager = new WebRTCConnectionManager(socket);
                    
                    if (isInitiator) {
                        // Initiate connection as the initiator
                        webRTCManager.connectToPeer(matchedSocketId);
                        connectionStatus.textContent = 'Status: Connecting to peer as initiator...';
                    } else {
                        // Wait for signaling from the initiator
                        console.log('Waiting for initiator to connect...');
                        connectionStatus.textContent = 'Status: Waiting for initiator to connect...';
                    }
                    
                    // Initialize VoiceChat
                    voiceChat = new VoiceChat(webRTCManager);
                    
                    // Set up event handlers for connection status
                    webRTCManager.on('connectionReady', async () => {
                        connectionStatus.textContent = 'Status: Connection established! Starting voice automatically...';
                        
                        // Automatically start voice when connected
                        try {
                            const success = await voiceChat.startVoice();
                            if (success) {
                                connectionStatus.textContent = 'Status: Voice chat active!';
                                startVoiceBtn.disabled = true;
                            } else {
                                connectionStatus.textContent = 'Status: Connection ready, click "Start Voice Chat" to begin';
                                startVoiceBtn.disabled = false;
                            }
                        } catch (error) {
                            console.error('Auto-start voice error:', error);
                            connectionStatus.textContent = 'Status: Connection ready, click "Start Voice Chat" to begin';
                            startVoiceBtn.disabled = false;
                        }
                    });
                    
                    webRTCManager.on('connectionClosed', () => {
                        connectionStatus.textContent = 'Status: Connection closed';
                        disableControls();
                        localWave.classList.remove('active');
                        remoteWave.classList.remove('active');
                    });
                    
                    webRTCManager.on('connectionError', (error) => {
                        connectionStatus.textContent = `Status: Connection error - ${error.message}`;
                        disableControls();
                        localWave.classList.remove('active');
                        remoteWave.classList.remove('active');
                    });
                    
                    // Handle local stream
                    voiceChat.on('localStream', (event) => {
                        const { stream } = event.detail;
                        localAudio.srcObject = stream;
                        localWave.classList.add('active');
                        
                        // Enable control buttons
                        stopVoiceBtn.disabled = false;
                        muteAudioBtn.disabled = false;
                        voiceEffectBtn.disabled = false;
                        startVoiceBtn.disabled = true;
                    });
                    
                    // Handle remote stream
                    voiceChat.on('remoteStream', (event) => {
                        const { stream } = event.detail;
                        remoteAudio.srcObject = stream;
                        remoteWave.classList.add('active');
                        connectionStatus.textContent = 'Status: Remote audio connected!';
                    });
                    
                    // Handle audio mute events
                    voiceChat.on('audioMuted', (event) => {
                        const { value } = event.detail;
                        connectionStatus.textContent = `Status: Peer has ${value ? 'muted' : 'unmuted'} their audio`;
                        if (value) {
                            remoteWave.classList.add('muted');
                        } else {
                            remoteWave.classList.remove('muted');
                        }
                    });
                    
                    // Handle voice request events
                    voiceChat.on('voiceRequest', (event) => {
                        const { value } = event.detail;
                        if (value) {
                            connectionStatus.textContent = 'Status: Peer requested to start voice chat';
                        } else {
                            connectionStatus.textContent = 'Status: Peer stopped their voice chat';
                            remoteWave.classList.remove('active');
                        }
                    });
                    
                    // Handle voice effect events
                    voiceChat.on('voiceEffect', (event) => {
                        const { value } = event.detail;
                        connectionStatus.textContent = `Status: Peer applied voice effect: ${value}`;
                    });
                    
                    // Handle voice effect changed events
                    voiceChat.on('voiceEffectChanged', (event) => {
                        const { value } = event.detail;
                        currentVoiceEffect = value;
                        voiceEffectBtn.textContent = `Effect: ${value}`;
                    });
                });
                
                return { socket, matchmakingClient };
            } catch (error) {
                console.error('Socket/matchmaking error:', error);
                connectionStatus.textContent = `Status: Connection error - ${error.message}`;
                return null;
            }
        }

        // Auto-initialize everything on page load
        const mediaSuccess = await initializeMediaAndQueue();
        if (mediaSuccess) {
            await initializeSocketAndMatchmaking();
        }
        
        // Log permission status if available (for debugging)
        if (navigator.permissions && navigator.permissions.query) {
            try {
                const micPermission = await navigator.permissions.query({ name: 'microphone' });
                console.log('Microphone permission status:', micPermission.state);
            } catch (err) {
                console.log('Permission query not supported:', err);
            }
        }

        // Fallback: Test Microphone button function (for when auto-init fails)
        async function testMicrophone() {
            try {
                connectionStatus.textContent = 'Status: Requesting microphone permissions...';
                console.log('Manual testing microphone access...');
                
                // Display available media devices
                const devices = await navigator.mediaDevices.enumerateDevices();
                const audioDevices = devices.filter(device => device.kind === 'audioinput');
                console.log('Available audio devices:', audioDevices);
                
                if (audioDevices.length === 0) {
                    connectionStatus.textContent = 'Status: No microphones detected on your device';
                    console.error('No audio input devices found');
                    return;
                }
                
                // Stop existing stream if any
                if (localStream) {
                    localStream.getTracks().forEach(track => track.stop());
                }
                
                // Request permissions and get media stream (audio only)
                localStream = await navigator.mediaDevices.getUserMedia({ 
                    video: false,
                    audio: {
                        echoCancellation: true,
                        noiseSuppression: true,
                        autoGainControl: true
                    }
                });
                
                // Display the stream in local audio
                localAudio.srcObject = localStream;
                localWave.classList.add('active');
                connectionStatus.textContent = 'Status: Microphone test successful! Attempting to join queue...';
                
                // Update button states
                testMicBtn.textContent = 'Stop Microphone Test';
                testMicBtn.style.backgroundColor = '#dc3545'; // Red color
                testMicBtn.onclick = stopMicrophoneTest;
                
                // Try to initialize matchmaking if not already in queue
                if (!isInQueue) {
                    await initializeSocketAndMatchmaking();
                }
                
            } catch (error) {
                console.error('Microphone test error:', error);
                connectionStatus.textContent = `Status: Failed to access microphone - ${error.message}`;
                
                // Add specific error messages
                if (error.name === 'NotAllowedError') {
                    connectionStatus.textContent = 'Status: Microphone access denied. Please allow microphone access in your browser settings and try again.';
                } else if (error.name === 'NotFoundError') {
                    connectionStatus.textContent = 'Status: No microphone found. Please connect a microphone and try again.';
                } else if (error.name === 'NotReadableError') {
                    connectionStatus.textContent = 'Status: Microphone is in use by another application. Please close other apps using your microphone.';
                }
            }
        }

        function stopMicrophoneTest() {
            if (localStream) {
                localStream.getTracks().forEach(track => track.stop());
                localStream = null;
                localAudio.srcObject = null;
                localWave.classList.remove('active');
            }
            
            connectionStatus.textContent = 'Status: Microphone test stopped';
            testMicBtn.textContent = 'Test Microphone';
            testMicBtn.style.backgroundColor = '#007bff'; // Blue color
            testMicBtn.onclick = testMicrophone;
        }

        // Set up test microphone button (fallback)
        testMicBtn.addEventListener('click', testMicrophone);

        // Button event handlers
        startVoiceBtn.addEventListener('click', async () => {
            if (!voiceChat) {
                connectionStatus.textContent = 'Status: Please wait for connection to be established';
                return;
            }
            
            try {
                connectionStatus.textContent = 'Status: Starting voice chat...';
                console.log('Starting voice chat with WebRTC...');
                
                const success = await voiceChat.startVoice();
                
                if (success) {
                    connectionStatus.textContent = 'Status: Voice started';
                    startVoiceBtn.disabled = true;
                    localWave.classList.add('active');
                } else {
                    connectionStatus.textContent = 'Status: Failed to start WebRTC voice';
                }
            } catch (error) {
                console.error('Voice start error:', error);
                connectionStatus.textContent = `Status: Failed to start voice - ${error.message}`;
            }
        });
        
        stopVoiceBtn.addEventListener('click', () => {
            if (localStream) {
                localStream.getTracks().forEach(track => track.stop());
                localStream = null;
                localAudio.srcObject = null;
                localWave.classList.remove('active');
            }
            
            if (voiceChat) {
                const success = voiceChat.stopVoice();
                if (success) {
                    connectionStatus.textContent = 'Status: Voice stopped';
                    disableVoiceControls();
                }
            } else {
                connectionStatus.textContent = 'Status: Voice stopped';
                disableVoiceControls();
            }
        });
        
        muteAudioBtn.addEventListener('click', () => {
            if (!voiceChat && localStream) {
                // Handle muting for local stream
                const audioTrack = localStream.getAudioTracks()[0];
                if (audioTrack) {
                    isAudioMuted = !isAudioMuted;
                    audioTrack.enabled = !isAudioMuted;
                    muteAudioBtn.textContent = isAudioMuted ? 'Unmute Audio' : 'Mute Audio';
                    muteAudioBtn.classList.toggle('muted', isAudioMuted);
                    localWave.classList.toggle('muted', isAudioMuted);
                    connectionStatus.textContent = `Status: Audio ${isAudioMuted ? 'muted' : 'unmuted'}`;
                }
                return;
            }
            
            if (!voiceChat) return;
            
            isAudioMuted = !isAudioMuted;
            const success = voiceChat.toggleAudio(isAudioMuted);
            
            if (success) {
                muteAudioBtn.textContent = isAudioMuted ? 'Unmute Audio' : 'Mute Audio';
                muteAudioBtn.classList.toggle('muted', isAudioMuted);
                localWave.classList.toggle('muted', isAudioMuted);
                connectionStatus.textContent = `Status: Audio ${isAudioMuted ? 'muted' : 'unmuted'}`;
            }
        });
        
        voiceEffectBtn.addEventListener('click', () => {
            if (!voiceChat) return;
            
            // Cycle through voice effects
            const effects = ['none', 'echo', 'robot', 'deep', 'high'];
            const currentIndex = effects.indexOf(currentVoiceEffect);
            const nextIndex = (currentIndex + 1) % effects.length;
            const nextEffect = effects[nextIndex];
            
            const success = voiceChat.setVoiceEffect(nextEffect);
            if (success) {
                currentVoiceEffect = nextEffect;
                voiceEffectBtn.textContent = `Effect: ${nextEffect}`;
                connectionStatus.textContent = `Status: Voice effect set to ${nextEffect}`;
            }
        });
        
        function disableControls() {
            startVoiceBtn.disabled = true;
            stopVoiceBtn.disabled = true;
            muteAudioBtn.disabled = true;
            voiceEffectBtn.disabled = true;
        }
        
        function disableVoiceControls() {
            startVoiceBtn.disabled = false;
            stopVoiceBtn.disabled = true;
            muteAudioBtn.disabled = true;
            voiceEffectBtn.disabled = true;
            localWave.classList.remove('active', 'muted');
            remoteWave.classList.remove('active', 'muted');
        }
    });
</script>
