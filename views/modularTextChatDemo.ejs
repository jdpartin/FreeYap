<!-- Modular Text Chat Demo Page -->
<div class="container py-4">
  
  <div class="row">
    <div class="col-md-12">
      <!-- Include the modular text chat component -->
      <%- include('components/modularTextChat', { 
        id: 'demo-chat',
        showTopics: true,
        enableEmoji: true,
        enableGif: true,
        enableVoiceRecording: false,
        containerHeight: '60vh'
      }) %>
    </div>  </div>
</div>

<!-- Required scripts for the chat functionality -->
<script src="/socket.io/socket.io.js"></script>
<script src="https://cdn.jsdelivr.net/npm/simple-peer/simplepeer.min.js"></script>
<!-- Include WebRTCCore.js for WebRTC functionality -->
<script src="/js/WebRTCCore.js"></script>

<!-- Initialize Socket.IO connection -->
<script>
  // Initialize Socket.IO connection
  window.socket = io();

  // Add some basic Socket.IO connection status handling
  window.socket.on('connect', () => {
    console.log('Socket connected, ID:', window.socket.id);
  });

  window.socket.on('disconnect', () => {
    console.log('Socket disconnected');
  });

  window.socket.on('error', (error) => {
    console.error('Socket error:', error);
  });
</script>

<script>
  // Initialize WebRTCCore for WebRTC connections
  const webRTCCore = new WebRTCCore({
    signalingServer: window.socket,
    widgetId: 'demo-chat',
    onStream: (stream) => {
      console.log('Stream received:', stream);
      // Handle incoming WebRTC stream (e.g., display video/audio)
    },
    onConnectionStateChange: (state) => {
      console.log('Connection state changed:', state);
      // Update UI or handle state changes
    }
  });

  // Example: Start WebRTC connection when socket connects
  window.socket.on('connect', () => {
    console.log('Starting WebRTC connection');
    webRTCCore.startConnection();
  });
</script>

<!-- Add a button for starting matchmaking and establishing a connection -->
<div class="text-center my-3">
  <button id="start-matchmaking" class="btn btn-primary">Start Matchmaking</button>
</div>

<script>
  // Add event listener to the matchmaking button
  document.getElementById('start-matchmaking').addEventListener('click', () => {
    console.log('Matchmaking button clicked');
    webRTCCore.startConnection();
  });
</script>
