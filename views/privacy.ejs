        </div>
        <div class="enhanced-list-item">
          <span class="icon">📢</span>
          <span>No advertising partners get your info</span>
        </div>
        <div class="enhanced-list-item">
          <span class="icon">🏢</span>
          <span>No corporate data sharing</span>
        </div>
        <div class="enhanced-list-item">
          <span class="icon">⚖️</span>
          <span>Only shared if legally required</span>
        </div>
