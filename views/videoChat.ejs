<div class="container my-0 p-0">
    <%- include('./components/topics-widget') %>
    <%- include('./components/video-chat-widget') %>
    <br>
    <%- include('./components/text-chat-widget') %>
    <div class="widget-controls-container">
        <%- include('./components/report-widget') %>
        <%- include('./components/matchmaking-controls-widget') %>
    </div>
</div>
<%- include('./components/webrtc-prerequisites') %>
<script>
    const chatMode = 'video';

    document.addEventListener('DOMContentLoaded', async () =>
    {        
        const connectionManager = new WebRTCConnectionManager();

        const topicsWidget = new TopicsWidget(connectionManager);
        const videoChatWidget = new VideoChatWidget(connectionManager);
        const textChatWidget = new TextChatWidget(connectionManager);
        const reportWidget = new ReportWidget(connectionManager);
        const matchmakingControlsWidget = new MatchmakingControlsWidget(connectionManager);

        let mediaInitializationSucceeded = await videoChatWidget.MediaInitialization;

        if (mediaInitializationSucceeded)
        {
            connectionManager.StartMatchmaking(chatMode);
        }
        else
        {
            window.alert("Camera and/or audio permissions denied. Please change your browser settings and refresh the page.");
        }
    });
</script>