<!-- Include the SimplePeer library via CDN -->
<script src="https://cdn.jsdelivr.net/npm/simple-peer/simplepeer.min.js"></script>

<script src="/socket.io/socket.io.js"></script>
<script src="/js/webRTC/WebRTCConnectionManager.js"></script>
<script src="/js/apiClients/matchmakingAPIClient.js"></script>
<script src="/js/modules/textChat.js"></script>

<!-- Include text chat specific styles -->
<link href="/textChat.css" rel="stylesheet">

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm chat-card">
                <!-- Chat header with controls -->
                <div class="card-header text-white d-flex justify-content-between align-items-center" style="background-color: var(--primary);">
                    <span id="chat-session-title">
                        <i class="bi bi-chat-dots-fill me-2"></i>Text Chat Test
                    </span>
                    <div class="status-indicator" id="connection-status">
                        <span class="badge bg-warning">Searching...</span>
                    </div>
                </div>
                
                <!-- Chat messages area -->
                <div class="card-body p-0">
                    <div class="status-bar searching text-center" id="status-bar">Searching for a match...</div>
                    <div class="chat-box" id="chat-log-container">
                        <div class="welcome-message text-center p-4">
                            <h5>Welcome to Text Chat Test</h5>
                            <p>You'll be matched with someone to chat anonymously.</p>
                        </div>
                    </div>
                    
                    <!-- Chat input area -->
                    <div class="input-group p-3 bg-light border-top">
                        <input type="text" id="chat-input" class="form-control" placeholder="Type a message..." disabled>
                        <button class="btn btn-primary" id="send-button" disabled>
                            <i class="bi bi-send-fill"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', async () => {
        const socket = io(); // Assuming socket.io is available globally
        const matchmakingClient = new MatchmakingAPIClient();
        
        const statusBar = document.getElementById('status-bar');
        const connectionStatus = document.getElementById('connection-status');
        const chatInput = document.getElementById('chat-input');
        const sendButton = document.getElementById('send-button');
        const chatLogContainer = document.getElementById('chat-log-container');

        try {
            // Wait for the socket to connect before retrieving the socket ID
            socket.on('connect', async () => {
                const socketId = socket.id;

                // Ensure mode is passed correctly
                const mode = 'text';

                // Join the matchmaking queue
                await matchmakingClient.joinQueue(socketId, mode);

                // Set a timeout for delayed matchmaking
                const matchmakingTimeout = setTimeout(async () => {
                    console.log('No match found within 10 seconds. Initiating delayed matchmaking...');
                    statusBar.textContent = 'Still searching for a match...';
                    await matchmakingClient.delayedMatchmaking(socketId, mode);
                }, 10000); // 10 seconds

                // Listen for match-found event
                socket.on('match-found', ({ socketId, matchedSocketId, isInitiator }) => {
                    console.log(`Match found! Matched with: ${matchedSocketId}, Initiator: ${isInitiator}`);

                    // Clear the matchmaking timeout if a match is found
                    clearTimeout(matchmakingTimeout);
                    
                    // Update UI to show connected state
                    statusBar.textContent = 'Connected to chat partner';
                    statusBar.classList.remove('searching');
                    statusBar.classList.add('connected');
                    connectionStatus.innerHTML = '<span class="badge bg-success">Connected</span>';
                    
                    // Enable chat input
                    chatInput.disabled = false;
                    sendButton.disabled = false;

                    const webRTCManager = new WebRTCConnectionManager(socket);

                    if (isInitiator) {
                        // Initiate connection as the initiator
                        webRTCManager.connectToPeer(matchedSocketId);
                    } else {
                        // Wait for signaling from the initiator
                        console.log('Waiting for initiator to connect...');
                    }

                    // Initialize TextChat
                    const textChat = new TextChat(webRTCManager);

                    // Clear welcome message
                    chatLogContainer.innerHTML = '';

                    // Handle sending messages
                    sendButton.addEventListener('click', () => {
                        sendMessage();
                    });
                    
                    chatInput.addEventListener('keypress', (e) => {
                        if (e.key === 'Enter') {
                            sendMessage();
                        }
                    });
                    
                    function sendMessage() {
                        const message = chatInput.value;
                        if (message.trim()) {
                            textChat.sendMessage(message);
                            
                            // Add message to UI
                            const messageEl = createMessageElement('sent', message);
                            chatLogContainer.appendChild(messageEl);
                            
                            // Clear input and scroll to bottom
                            chatInput.value = '';
                            chatLogContainer.scrollTop = chatLogContainer.scrollHeight;
                        }
                    }

                    // Handle receiving messages
                    textChat.on('message', (event) => {
                        const { content } = event.detail;
                        
                        // Add message to UI
                        const messageEl = createMessageElement('received', content);
                        chatLogContainer.appendChild(messageEl);
                        
                        // Scroll to bottom
                        chatLogContainer.scrollTop = chatLogContainer.scrollHeight;
                    });
                    
                    function createMessageElement(type, content) {
                        const container = document.createElement('div');
                        container.className = `message-container ${type}`;
                        
                        const message = document.createElement('div');
                        message.className = `message message-${type}`;
                        message.textContent = content;
                        
                        const meta = document.createElement('div');
                        meta.className = 'message-meta';
                        const time = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                        meta.textContent = time;
                        
                        container.appendChild(message);
                        container.appendChild(meta);
                        
                        return container;
                    }
                });
            });
        } catch (error) {
            console.error('Error setting up text chat:', error);
            statusBar.textContent = 'Error connecting to chat service';
            statusBar.classList.remove('searching');
            statusBar.style.backgroundColor = '#f8d7da';
            statusBar.style.color = '#721c24';
        }
    });
</script>