<link rel="stylesheet" href="/css/findGames-page.css">

<div class="widget-container">
    <div class="widget-header">
        <h1>Find Multiplayer Games</h1>
        <p>Discover and play amazing multiplayer web games with friends.<br>No download required.</p>
    </div>

    <div class="widget-content">
        <div class="search-section">
            <input type="text" id="game-search-bar" placeholder="Search games from OnlineGames.io...">
            <select id="game-category-select">
                <option value="">Select Category</option>
                <!-- Categories will be populated dynamically -->
            </select>
            <div class="mobile-warning">
                Games may not work on mobile devices.
            </div>
        </div>

        <div id="game-container"></div>
    </div>
</div>

<script src="/js/apiClients/gamesAPIClient.js"></script>
<script src="/js/findGames-page.js"></script>