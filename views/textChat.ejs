<!-- Include text chat specific styles -->
<link href="/textChat.css" rel="stylesheet">
<link href="/textChatMedia.css" rel="stylesheet">

<div class="container py-4">
    <div class="row justify-content-center">
    <div class="col-md-8">
      <!-- Topics Display -->
      <div class="topics-display">
        <div class="topics-section user-topics">
          <div class="topics-title">
            <i class="fas fa-user"></i>
            Your Topics
          </div>
          <div class="topics-list" id="user-topics-list">
            <div class="topics-empty">No topics selected</div>
          </div>
        </div>        <div class="topics-section partner-topics">
          <div class="topics-title">
            <i class="fas fa-users"></i>
            <span id="partner-topics-header">Partner's Topics</span>
          </div>
          <div class="topics-list" id="partner-topics-list">
            <div class="topics-empty">Waiting for partner...</div>
          </div>
        </div>
      </div>      <div class="card shadow-sm chat-card">        <!-- Chat header with controls -->
        <div class="card-header text-white d-flex justify-content-between align-items-center" style="background-color: var(--primary);">
          <span id="chat-session-title">
            <i class="bi bi-chat-dots-fill me-2"></i>Chat Session
            <i class="bi bi-info-circle ms-2 chat-info-icon" 
               title="This is a randomly generated name to help you connect personally while staying anonymous" 
               style="cursor: help; display: none;"></i>
          </span>
          <div class="chat-controls">
            <button id="startButton" class="btn btn-sm btn-light me-1">
              <i class="bi bi-play-fill"></i> Start
            </button>
            <button id="endButton" class="btn btn-sm btn-danger" disabled>
              <i class="bi bi-x-lg"></i> End
            </button>
          </div>
        </div>
        
        <!-- Chat messages area -->
        <div class="card-body p-0">          <div class="chat-box" id="chatBox">
            <div class="welcome-message text-center p-4">
              <div class="mb-3">
                <i class="bi bi-chat-text fs-1" style="color: var(--primary);"></i>
              </div>
              <h5>Welcome to FreeYap Text Chat!</h5>
              <p class="text-muted">No messages yet. Start the conversation!</p>
            </div>
          </div>
        </div>
          <!-- Status message -->
        <div id="statusMessage" class="text-center bg-light border-top border-bottom status-bar"></div>
          <!-- Message input area -->        <div class="card-footer p-2">
          <div class="input-group">            <button class="btn btn-outline-secondary emoji-button me-2" id="emojiButton" disabled>
              <i class="bi bi-emoji-smile"></i>
            </button>
            <input type="text" class="form-control" placeholder="Type your message here..." id="messageInput" disabled>
            <button class="btn" id="sendButton" style="background-color: var(--primary); color: white;" disabled>
              <i class="bi bi-send-fill"></i>
            </button>          </div>
              <!-- Utility UI Panels -->
            <!-- Each panel will be shown based on the selected utility -->
            
            <!-- Voice Recording UI -->
            <div class="utility-panel voice-recorder-ui d-none" id="voiceRecorderUI">
              <div class="panel-header">
                <h6><i class="bi bi-mic-fill me-2"></i>Voice Recording</h6>
                <button class="btn-close btn-sm" aria-label="Close"></button>
              </div>
              <div class="voice-recorder-container text-center">
                <div class="voice-recorder-timer mb-2" id="voiceTimer">00:00</div>
                <div class="voice-recorder-visualizer mb-3" id="voiceVisualizer">
                  <div class="visualizer-bar"></div>
                  <div class="visualizer-bar"></div>
                  <div class="visualizer-bar"></div>
                  <div class="visualizer-bar"></div>
                  <div class="visualizer-bar"></div>
                </div>
                <div class="voice-recorder-controls">
                  <button class="btn btn-danger btn-circle me-2" id="voiceRecordButton">
                    <i class="bi bi-mic-fill"></i>
                  </button>
                  <button class="btn btn-secondary btn-circle me-2 d-none" id="voiceStopButton">
                    <i class="bi bi-stop-fill"></i>
                  </button>
                  <button class="btn btn-success btn-circle me-2 d-none" id="voiceSendButton">
                    <i class="bi bi-send-fill"></i>
                  </button>
                  <button class="btn btn-outline-secondary btn-circle" id="voiceCancelButton">
                    <i class="bi bi-x-lg"></i>
                  </button>
                </div>
              </div>
            </div>
            
            <!-- Video Recording UI -->
            <div class="utility-panel video-recorder-ui d-none" id="videoRecorderUI">
              <div class="panel-header">
                <h6><i class="bi bi-camera-video-fill me-2"></i>Video Recording</h6>
                <button class="btn-close btn-sm" aria-label="Close"></button>
              </div>
              <div class="video-recorder-container">
                <div class="video-preview-container">
                  <video id="videoPreview" muted playsinline></video>
                </div>
                <div class="video-recorder-timer mb-2" id="videoTimer">00:00</div>
                <div class="video-recorder-controls">
                  <button class="btn btn-danger btn-circle me-2" id="videoRecordButton">
                    <i class="bi bi-record-circle"></i>
                  </button>
                  <button class="btn btn-secondary btn-circle me-2 d-none" id="videoStopButton">
                    <i class="bi bi-stop-fill"></i>
                  </button>
                  <button class="btn btn-success btn-circle me-2 d-none" id="videoSendButton">
                    <i class="bi bi-send-fill"></i>
                  </button>
                  <button class="btn btn-outline-secondary btn-circle" id="videoCancelButton">
                    <i class="bi bi-x-lg"></i>
                  </button>
                </div>
              </div>
            </div>
            
            <!-- Camera/Photo UI -->
            <div class="utility-panel photo-ui d-none" id="photoUI">
              <div class="panel-header">
                <h6><i class="bi bi-camera-fill me-2"></i>Take Photo</h6>
                <button class="btn-close btn-sm" aria-label="Close"></button>
              </div>
              <div class="camera-container">
                <div class="camera-preview-container">
                  <video id="cameraPreview" autoplay muted playsinline></video>
                  <img id="photoPreview" class="d-none" alt="Photo preview">
                </div>
                <div class="camera-controls">
                  <button class="btn btn-primary btn-circle me-2" id="takePictureButton">
                    <i class="bi bi-camera-fill"></i>
                  </button>
                  <button class="btn btn-secondary btn-circle me-2 d-none" id="retakePictureButton">
                    <i class="bi bi-arrow-repeat"></i>
                  </button>
                  <button class="btn btn-success btn-circle me-2 d-none" id="sendPictureButton">
                    <i class="bi bi-send-fill"></i>
                  </button>
                  <button class="btn btn-outline-secondary btn-circle" id="cancelPictureButton">
                    <i class="bi bi-x-lg"></i>
                  </button>
                </div>
              </div>
            </div>
            
            <!-- Screen Share UI -->
            <div class="utility-panel screen-share-ui d-none" id="screenShareUI">
              <div class="panel-header">
                <h6><i class="bi bi-display me-2"></i>Screen Sharing</h6>
                <button class="btn-close btn-sm" aria-label="Close"></button>
              </div>
              <div class="screen-share-container">
                <div class="screen-share-preview-container">
                  <video id="screenSharePreview" autoplay muted playsinline></video>
                </div>
                <div class="screen-share-controls">
                  <button class="btn btn-primary btn-circle me-2" id="startScreenShareButton">
                    <i class="bi bi-display"></i>
                  </button>
                  <button class="btn btn-danger btn-circle me-2 d-none" id="stopScreenShareButton">
                    <i class="bi bi-stop-fill"></i>
                  </button>
                  <button class="btn btn-outline-secondary btn-circle" id="cancelScreenShareButton">
                    <i class="bi bi-x-lg"></i>
                  </button>
                </div>
              </div>
            </div>
            
            <!-- Drawing UI -->
            <div class="utility-panel drawing-ui d-none" id="drawingUI">
              <div class="panel-header">
                <h6><i class="bi bi-brush-fill me-2"></i>Drawing</h6>
                <button class="btn-close btn-sm" aria-label="Close"></button>
              </div>
              <div class="drawing-container">
                <canvas id="drawingCanvas" width="300" height="200"></canvas>
                <div class="drawing-tools">
                  <div class="color-picker">
                    <button class="color-btn" data-color="#000000" style="background-color: #000000;"></button>
                    <button class="color-btn" data-color="#ff0000" style="background-color: #ff0000;"></button>
                    <button class="color-btn" data-color="#00ff00" style="background-color: #00ff00;"></button>
                    <button class="color-btn" data-color="#0000ff" style="background-color: #0000ff;"></button>
                    <button class="color-btn" data-color="#ffff00" style="background-color: #ffff00;"></button>
                  </div>
                  <div class="drawing-controls">
                    <button class="btn btn-sm btn-outline-secondary me-1" id="clearDrawingButton">
                      <i class="bi bi-eraser-fill"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-secondary me-1" id="undoDrawingButton">
                      <i class="bi bi-arrow-counterclockwise"></i>
                    </button>
                    <button class="btn btn-success btn-sm" id="sendDrawingButton">
                      <i class="bi bi-send-fill"></i> Send
                    </button>
                  </div>
                </div>
              </div>
            </div>
            
            <!-- Poll UI -->
            <div class="utility-panel poll-ui d-none" id="pollUI">
              <div class="panel-header">
                <h6><i class="bi bi-bar-chart-fill me-2"></i>Create Poll</h6>
                <button class="btn-close btn-sm" aria-label="Close"></button>
              </div>
              <div class="poll-container">
                <div class="form-group mb-2">
                  <label for="pollQuestion" class="form-label small">Question</label>
                  <input type="text" class="form-control form-control-sm" id="pollQuestion" placeholder="Ask a question...">
                </div>
                <div id="pollOptionsContainer">
                  <div class="form-group mb-2 poll-option">
                    <div class="input-group input-group-sm">
                      <span class="input-group-text">1</span>
                      <input type="text" class="form-control" placeholder="Option">
                    </div>
                  </div>
                  <div class="form-group mb-2 poll-option">
                    <div class="input-group input-group-sm">
                      <span class="input-group-text">2</span>
                      <input type="text" class="form-control" placeholder="Option">
                    </div>
                  </div>
                </div>
                <button class="btn btn-sm btn-outline-secondary w-100 mb-2" id="addPollOptionButton">
                  <i class="bi bi-plus"></i> Add Option
                </button>
                <button class="btn btn-sm btn-success w-100" id="createPollButton">
                  <i class="bi bi-send-fill"></i> Create Poll
                </button>
              </div>
            </div>
              <!-- Location Sharing UI has been removed -->
            
            <!-- Hidden file inputs -->
            <input type="file" id="attachmentInput" style="display: none;">
            <input type="file" id="imageInput" accept="image/*" style="display: none;">
            <input type="file" id="videoInput" accept="video/*" style="display: none;">
          </div>
          
          <!-- Emoji and GIF Panel -->
          <div class="emoji-gif-panel mt-2 d-none" id="emojiGifPanel">            <ul class="nav nav-tabs" id="emojiGifTabs" role="tablist">
              <li class="nav-item" role="presentation">
                <button class="nav-link active" id="emojis-tab" data-bs-toggle="tab" data-bs-target="#emojis" type="button" role="tab" aria-controls="emojis" aria-selected="true">Emojis</button>
              </li>
              <li class="nav-item" role="presentation">
                <button class="nav-link" id="gifs-tab" data-bs-toggle="tab" data-bs-target="#gifs" type="button" role="tab" aria-controls="gifs" aria-selected="false">GIFs</button>
              </li>
              <li class="nav-item" role="presentation">
                <button class="nav-link" id="media-tab" data-bs-toggle="tab" data-bs-target="#media" type="button" role="tab" aria-controls="media" aria-selected="false">Media</button>
              </li>
            </ul><div class="tab-content p-2" id="emojiGifTabContent">
              <div class="tab-pane fade show active" id="emojis" role="tabpanel" aria-labelledby="emojis-tab">
                <!-- Emoji Categories -->
                <div class="emoji-categories mb-2">
                  <button class="btn btn-sm btn-outline-secondary active" data-category="smileys" title="Smileys & Emotion">😊</button>
                  <button class="btn btn-sm btn-outline-secondary" data-category="people" title="People & Body">👋</button>
                  <button class="btn btn-sm btn-outline-secondary" data-category="animals" title="Animals & Nature">🐶</button>
                  <button class="btn btn-sm btn-outline-secondary" data-category="food" title="Food & Drink">🍕</button>
                  <button class="btn btn-sm btn-outline-secondary" data-category="activities" title="Activities">⚽</button>
                  <button class="btn btn-sm btn-outline-secondary" data-category="travel" title="Travel & Places">🚗</button>
                  <button class="btn btn-sm btn-outline-secondary" data-category="objects" title="Objects">💎</button>
                  <button class="btn btn-sm btn-outline-secondary" data-category="symbols" title="Symbols">❤️</button>
                </div>
                <div class="emoji-container" id="emojiContainer">
                  <!-- Emojis will be populated by JavaScript -->
                </div>
              </div>              <div class="tab-pane fade" id="gifs" role="tabpanel" aria-labelledby="gifs-tab">
                <div class="gif-search mb-2">
                  <input type="text" class="form-control" id="gifSearchInput" placeholder="Search GIFs...">
                </div>
                <div class="gif-container" id="gifResults">
                  <div class="text-center p-3 text-muted">
                    Search for GIFs to display here
                  </div>
                </div>
              </div>              <div class="tab-pane fade" id="media" role="tabpanel" aria-labelledby="media-tab">
                <div class="media-options-container p-2">
                  <div class="utilities-grid">
                    <!-- Media Section -->
                    <button class="utility-item" id="attachmentOption" title="Attach Files">
                      <div class="utility-icon">
                        <i class="bi bi-paperclip"></i>
                      </div>
                      <span>Files</span>
                    </button>
                    <button class="utility-item" id="photoOption" title="Take Photo">
                      <div class="utility-icon">
                        <i class="bi bi-camera-fill"></i>
                      </div>
                      <span>Photo</span>
                    </button>
                    <button class="utility-item" id="videoRecordOption" title="Record Video">
                      <div class="utility-icon">
                        <i class="bi bi-camera-video-fill"></i>
                      </div>
                      <span>Video</span>
                    </button>
                    <button class="utility-item" id="voiceRecordOption" title="Record Audio">
                      <div class="utility-icon">
                        <i class="bi bi-mic-fill"></i>
                      </div>
                      <span>Audio</span>
                    </button>
                    
                    <!-- Sharing Section -->
                    <button class="utility-item" id="screenShareOption" title="Share Screen">
                      <div class="utility-icon">
                        <i class="bi bi-display"></i>
                      </div>
                      <span>Screen</span>
                    </button>
                    <button class="utility-item" id="drawingOption" title="Create Drawing">
                      <div class="utility-icon">
                        <i class="bi bi-brush-fill"></i>
                      </div>
                      <span>Draw</span>
                    </button>
                    <button class="utility-item" id="pollOption" title="Create Poll">
                      <div class="utility-icon">
                        <i class="bi bi-bar-chart-fill"></i>
                      </div>
                      <span>Poll</span>
                    </button>
                    <button class="utility-item" id="translateOption" title="Translate Message">
                      <div class="utility-icon">
                        <i class="bi bi-translate"></i>
                      </div>
                      <span>Translate</span>
                    </button>
                  </div>
                </div>
              </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Privacy notice -->
      <div class="mt-3 text-center text-muted small">
        <i class="bi bi-shield-lock me-1"></i>
        Your conversations are end-to-end encrypted and not stored on our servers.
      </div>
    </div>
  </div>
</div>

