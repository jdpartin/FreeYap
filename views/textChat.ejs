<script src="/WebRTCClient.js"></script>

<script>
  document.addEventListener('DOMContentLoaded', function()
  {
      console.log('Text chat UI initializing');
        const startButton = document.getElementById('startButton');
      const endButton = document.getElementById('endButton');
      const statusMessage = document.getElementById('statusMessage');
      const chatBox = document.getElementById('chatBox');
      const messageInput = document.getElementById('messageInput');
      const sendButton = document.getElementById('sendButton');
      const emojiButton = document.getElementById('emojiButton');
      const emojiGifPanel = document.getElementById('emojiGifPanel');
      const emojiItems = document.querySelectorAll('.emoji-item');
      const gifSearchInput = document.getElementById('gifSearchInput');
      const gifResults = document.getElementById('gifResults');
      
      console.log('Elements found:', {
          startButton: !!startButton,
          endButton: !!endButton,
          statusMessage: !!statusMessage,
          chatBox: !!chatBox,
          messageInput: !!messageInput,
          sendButton: !!sendButton,
          emojiButton: !!emojiButton,
          emojiGifPanel: !!emojiGifPanel
      });
      
      // Override the appendMessage function from WebRTCClient.js to use our chat UI
      window.appendMessage = function(sender, message) {
          console.log(`Custom appendMessage called with: ${sender}: ${message}`);
          
          // Remove welcome message if it exists
          const welcomeMessage = chatBox.querySelector('.welcome-message');
          if (welcomeMessage) {
              welcomeMessage.remove();
          }
          
          const messageElement = document.createElement('div');
          messageElement.className = sender === 'You' ? 'message-container sent' : 'message-container received';
          
          // Format the current time
          const now = new Date();
          const timeString = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
          
          messageElement.innerHTML = `
            <div class="message ${sender === 'You' ? 'message-sent' : 'message-received'}">
              <div class="message-content">${message}</div>
              <div class="message-meta">
                <span class="message-time">${timeString}</span>
                ${sender === 'You' ? '<i class="bi bi-check2-all"></i>' : ''}
              </div>
            </div>
          `;
          
          chatBox.appendChild(messageElement);
          // Scroll to the bottom of the chat box
          chatBox.scrollTop = chatBox.scrollHeight;
      };      // Fix the variable names to match what WebRTCClient.js is expecting
      // These need to be global variables
      window.chatInput = messageInput;
      window.chatSendButton = sendButton;
      window.chatMessages = chatBox;
      
      // Make sure global variables are accessible without window prefix
      // This is needed because WebRTCClient.js accesses these variables directly
      globalThis.chatInput = messageInput;
      globalThis.chatSendButton = sendButton;
      globalThis.chatMessages = chatBox;
      
      // Update UI status with icons
      function updateStatus(status, iconClass = 'bi-info-circle')
      {
          statusMessage.innerHTML = `<i class="${iconClass} me-2"></i>${status}`;
      }      // Variable to track delayed matchmaking timeout
      let delayedMatchmakingTimeout = null;
      let matchFound = false;

      // Wait for WebRTCClient.js to load and use its socket connection
      // Listen for match-found event to abort delayed matchmaking
      if (typeof socket !== 'undefined') {
          socket.on('match-found', () => {
              console.log('Match found! Aborting delayed matchmaking...');
              matchFound = true;
              if (delayedMatchmakingTimeout) {
                  clearTimeout(delayedMatchmakingTimeout);
                  delayedMatchmakingTimeout = null;
                  console.log('Delayed matchmaking timeout cleared');
              }
          });
      } else {
          console.error('Socket not available from WebRTCClient.js');
      }

      // Don't request media permissions for text chat
      console.log('Text chat page loaded - no media permissions requested');

      // Start button click handler
      startButton.addEventListener('click', async () =>
      {
          console.log('Start button clicked, joining matchmaking queue...');
          
          // Reset match state
          matchFound = false;
          if (delayedMatchmakingTimeout) {
              clearTimeout(delayedMatchmakingTimeout);
              delayedMatchmakingTimeout = null;
          }

          // Update status and disable button
          updateStatus('Looking for a chat partner...', 'bi-hourglass-split');
          statusMessage.classList.add('searching');
          startButton.disabled = true;

          // Extract topics from URL query parameters
          const urlParams = new URLSearchParams(window.location.search);
          const topicsParam = urlParams.get('topics');
          let topics = [];
          
          if (topicsParam) {
              try {
                  topics = JSON.parse(decodeURIComponent(topicsParam));
                  console.log('Extracted topics from URL:', topics);
              } catch (e) {
                  console.error('Error parsing topics from URL:', e);
              }
          }

          try
          {
              // Call the join-queue endpoint
              const response = await fetch('/api/matchmaking/join-queue', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ 
                    socketId: mySocketId, 
                    mode: 'text', // Specify the mode as 'text'
                    topics: topics 
                  })
              });

              if (!response.ok)
              {
                  throw new Error('Failed to join matchmaking queue');
              }

              console.log('Successfully joined matchmaking queue');

              // Wait for 10 seconds before calling delayed matchmaking
              delayedMatchmakingTimeout = setTimeout(async () =>
              {
                  // Check if match was already found
                  if (matchFound) {
                      console.log('Match already found, skipping delayed matchmaking');
                      return;
                  }

                  console.log('10 seconds passed, calling delayed matchmaking...');

                  try
                  {                  const delayedResponse = await fetch('/api/matchmaking/delayed-matchmaking', {
                          method: 'POST',
                          headers: { 'Content-Type': 'application/json' },
                          body: JSON.stringify({ socketId: mySocketId, topics: topics })
                      });

                      if (!delayedResponse.ok)
                      {
                          throw new Error('Failed to perform delayed matchmaking');
                      }

                      console.log('Successfully called delayed matchmaking');
                  }
                  catch (error)
                  {
                      console.error('Error during delayed matchmaking:', error);
                      updateStatus(`Error: ${error.message}`, 'bi-exclamation-triangle');
                      startButton.disabled = false;
                      statusMessage.classList.remove('searching');
                  }
              }, 10000);
          }
          catch (error)
          {
              console.error('Error joining matchmaking queue:', error);
              updateStatus(`Error: ${error.message}`, 'bi-exclamation-triangle');
              startButton.disabled = false;
              statusMessage.classList.remove('searching');
          }
      });

      // End button click handler
      endButton.addEventListener('click', () =>
      {
          endCurrentChat();
      });      // Function to end the current chat session
      function endCurrentChat()
      {
          // Reset UI state
          startButton.disabled = false;
          endButton.disabled = true;
          statusMessage.innerHTML = '';
          statusMessage.classList.remove('searching', 'connected');
          
          // Reset chat box
          chatBox.innerHTML = `
            <div class="welcome-message text-center p-4">              <div class="mb-3">
                <i class="bi bi-chat-text fs-1" style="color: var(--primary);"></i>
              </div>
              <h5>Welcome to FreeYap Text Chat!</h5>
              <p class="text-muted">No messages yet. Start the conversation!</p>
            </div>
          `;
          
          // Disable message input
          messageInput.disabled = true;
          sendButton.disabled = true;
          emojiButton.disabled = true;
          
          // Hide emoji panel if it's open
          emojiGifPanel.classList.add('d-none');
          
          // Destroy the WebRTC connection
          if (peer)
          {
              peer.destroy();
              peer = null;
          }
          partnerSocketId = null;
      }// Add additional event handlers for sending messages
      
      // Handle Enter key press
      messageInput.addEventListener('keypress', (event) =>
      {
          if (event.key === 'Enter')
          {
              event.preventDefault(); // Prevent default form submission
              sendChatMessage();
          }
      });
      
      // Add our own click handler for the send button as a backup
      sendButton.addEventListener('click', () => {
          console.log('Send button clicked via our custom handler');
          sendChatMessage();
      });
      
      // Function to send messages that works with our UI
      function sendChatMessage()
      {
          const message = messageInput.value.trim();
          if (message && peer && !peer.destroyed)
          {
              console.log('Sending message:', message);
              peer.send(message);
              appendMessage('You', message);
              messageInput.value = ''; // Clear input after sending
          }
      }      // Handle emoji button click to show/hide emoji panel
      emojiButton.addEventListener('click', () => 
      {
          emojiGifPanel.classList.toggle('d-none');
      });
      
      // Add click handlers for emoji buttons
      emojiItems.forEach(item => 
      {
          item.addEventListener('click', () => 
          {
              const emoji = item.textContent;
              // Insert emoji at cursor position
              insertTextAtCursor(messageInput, emoji);
          });
      });
      
      // Function to insert text at cursor position in input field
      function insertTextAtCursor(input, text) 
      {
          const start = input.selectionStart;
          const end = input.selectionEnd;
          const value = input.value;
          
          input.value = value.substring(0, start) + text + value.substring(end);
          
          // Move cursor position after the inserted text
          input.selectionStart = input.selectionEnd = start + text.length;
          input.focus();
      }
      
      // Handle GIF search functionality
      gifSearchInput.addEventListener('input', debounce(function() 
      {
          const searchTerm = this.value.trim();
          if (searchTerm.length > 2) 
          {
              searchGifs(searchTerm);
          }
      }, 500));
      
      // Debounce function to limit API calls
      function debounce(func, delay) 
      {
          let timeout;
          return function() 
          {
              const context = this;
              const args = arguments;
              clearTimeout(timeout);
              timeout = setTimeout(() => func.apply(context, args), delay);
          };
      }
      
      // Function to search GIFs using a mock API (replace with actual GIF API)
      function searchGifs(query) 
      {
          // Display loading state
          gifResults.innerHTML = '<div class="text-center p-3"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div></div>';
          
          // Sample GIFs - replace with actual API call
          const sampleGifs = [
              'https://media.giphy.com/media/v1.Y2lkPTc5MGI3NjExcTFhMGFtOHg2cDk3dDltbWV4dXp2cjZsbG9zZDkwYWd3cjZtcmI1YSZlcD12MV9pbnRlcm5hbF9naWZfYnlfaWQmY3Q9Zw/13CoXDiaCcCoyk/giphy.gif',
              'https://media.giphy.com/media/v1.Y2lkPTc5MGI3NjExNmEyMDRkYmEwM2MyN2YxY2RlODRjYzQ1ZTljNjJiNjdmOTExM2NiMSZlcD12MV9pbnRlcm5hbF9naWZfYnlfaWQmY3Q9Zw/xUPGcg1IJEKGCI6r5e/giphy.gif',
              'https://media.giphy.com/media/v1.Y2lkPTc5MGI3NjExNmduYnJoYTJnMzBuN2xuZjc2M3dvN2U1aGJiNjB0dTB2MzJ0d3JtYiZlcD12MV9pbnRlcm5hbF9naWZfYnlfaWQmY3Q9Zw/3o7abKhOpu0NwenH3O/giphy.gif',
              'https://media.giphy.com/media/v1.Y2lkPTc5MGI3NjExNnJseTdwc3ExeDhjZWVhZ2Z6YmFheTI4bHA5NXZ5c3RjdnAzN3l1eSZlcD12MV9pbnRlcm5hbF9naWZfYnlfaWQmY3Q9Zw/10bxTLrpJNS0PC/giphy.gif'
          ];
          
          // Simulate API delay
          setTimeout(() => {
              let html = '';
              
              if (sampleGifs.length > 0) 
              {
                  sampleGifs.forEach(url => {
                      html += `<div class="gif-item"><img src="${url}" alt="GIF" data-gif-url="${url}"></div>`;
                  });
              } 
              else 
              {
                  html = '<div class="text-center p-3 text-muted">No GIFs found</div>';
              }
              
              gifResults.innerHTML = html;
              
              // Add click handlers to GIFs
              document.querySelectorAll('.gif-item img').forEach(img => {
                  img.addEventListener('click', () => {
                      // For this implementation, we'll just send the GIF URL as a message
                      const gifUrl = img.getAttribute('data-gif-url');
                      sendGif(gifUrl);
                      emojiGifPanel.classList.add('d-none');
                  });
              });
          }, 700);
      }
      
      // Function to send a GIF
      function sendGif(gifUrl) 
      {
          if (peer && !peer.destroyed) 
          {
              const gifMessage = `[GIF:${gifUrl}]`;
              peer.send(gifMessage);
              
              // Display the GIF in the chat
              const messageElement = document.createElement('div');
              messageElement.className = 'message-container sent';
              
              const now = new Date();
              const timeString = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
              
              messageElement.innerHTML = `
                <div class="message message-sent">
                  <div class="message-content"><img src="${gifUrl}" alt="GIF" style="max-width: 100%; border-radius: 8px;"></div>
                  <div class="message-meta">
                    <span class="message-time">${timeString}</span>
                    <i class="bi bi-check2-all"></i>
                  </div>
                </div>
              `;
              
              chatBox.appendChild(messageElement);
              chatBox.scrollTop = chatBox.scrollHeight;
          }
      }
      
      // Override appendMessage to handle GIFs
      const originalAppendMessage = window.appendMessage;
      window.appendMessage = function(sender, message) 
      {
          // Check if message is a GIF
          if (message.startsWith('[GIF:') && message.endsWith(']')) 
          {
              const gifUrl = message.substring(5, message.length - 1);
              
              // Remove welcome message if it exists
              const welcomeMessage = chatBox.querySelector('.welcome-message');
              if (welcomeMessage) {
                  welcomeMessage.remove();
              }
              
              const messageElement = document.createElement('div');
              messageElement.className = sender === 'You' ? 'message-container sent' : 'message-container received';
              
              const now = new Date();
              const timeString = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
              
              messageElement.innerHTML = `
                <div class="message ${sender === 'You' ? 'message-sent' : 'message-received'}">
                  <div class="message-content"><img src="${gifUrl}" alt="GIF" style="max-width: 100%; border-radius: 8px;"></div>
                  <div class="message-meta">
                    <span class="message-time">${timeString}</span>
                    ${sender === 'You' ? '<i class="bi bi-check2-all"></i>' : ''}
                  </div>
                </div>
              `;
              
              chatBox.appendChild(messageElement);
              chatBox.scrollTop = chatBox.scrollHeight;
          } 
          else 
          {
              // Use original function for regular messages
              originalAppendMessage(sender, message);
          }
      };

      // Extend the WebRTCClient's setupPeer function for text chat
      const originalSetupPeer = window.setupPeer || function() {};
      
      window.setupPeer = function(p, toSocketId)
      {
          if (typeof originalSetupPeer === 'function')
          {
              originalSetupPeer(p, toSocketId);
          }
          
          // Add our custom text chat functionality          
          p.on('connect', () =>
          {
              console.log('Peer connection established');
              
              // Enable UI for active chat
              endButton.disabled = false;
              messageInput.disabled = false;
              sendButton.disabled = false;
              emojiButton.disabled = false;
              
              // Update status
              updateStatus('Connected! Chat session started.', 'bi-check-circle-fill');
              statusMessage.classList.remove('searching');
              statusMessage.classList.add('connected');
          });
          
          p.on('close', () =>
          {
              console.log('Peer connection closed');
              endCurrentChat();
          });
          
          p.on('error', err =>
          {
              console.error('Peer connection error:', err);
              updateStatus(`Error: ${err.message}`, 'bi-exclamation-triangle');
              endCurrentChat();
          });
          
          return p;
      };
  });
</script>
