<!-- Include text chat specific styles -->
<link href="/textChat.css" rel="stylesheet">

<div class="container py-4">
  <div class="text-center mb-4">
    <h1 class="fw-bold text-primary">Text Chat</h1>
    <p class="text-muted">Chat with others via text in real-time.</p>
  </div>
  
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card shadow-sm chat-card">
        <!-- Chat header with controls -->
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
          <span><i class="bi bi-chat-dots-fill me-2"></i>Chat Session</span>
          <div class="chat-controls">
            <button id="startButton" class="btn btn-sm btn-light me-1">
              <i class="bi bi-play-fill"></i> Start
            </button>
            <button id="endButton" class="btn btn-sm btn-danger" disabled>
              <i class="bi bi-x-lg"></i> End
            </button>
          </div>
        </div>
        
        <!-- Chat messages area -->
        <div class="card-body p-0">
          <div class="chat-box" id="chatBox">
            <div class="welcome-message text-center p-4">
              <div class="mb-3">
                <i class="bi bi-chat-text fs-1 text-primary"></i>
              </div>
              <h5>Welcome to FreeYap Text Chat!</h5>
              <p class="text-muted">No messages yet. Start the conversation!</p>
            </div>
          </div>
        </div>
        
        <!-- Status message -->
        <div id="statusMessage" class="text-center py-2 bg-light border-top border-bottom status-bar"></div>
        
        <!-- Message input area -->
        <div class="card-footer p-2">
          <div class="input-group">
            <input type="text" class="form-control" placeholder="Type your message here..." id="messageInput" disabled>
            <button class="btn btn-primary" id="sendButton" disabled>
              <i class="bi bi-send-fill"></i>
            </button>
          </div>
          
          <!-- Message formatting tools -->
          <div class="d-flex justify-content-between mt-2">
            <div class="message-tools">
              <button class="btn btn-sm btn-outline-secondary me-1 emoji-button" disabled>
                <i class="bi bi-emoji-smile"></i>
              </button>
              <button class="btn btn-sm btn-outline-secondary me-1 gif-button" disabled>
                <i class="bi bi-filetype-gif"></i>
              </button>
              <button class="btn btn-sm btn-outline-secondary me-1" disabled>
                <i class="bi bi-paperclip"></i>
              </button>
              <button class="btn btn-sm btn-outline-secondary" disabled>
                <i class="bi bi-camera"></i>
              </button>
            </div>
            <div class="text-format-tools">
              <button class="btn btn-sm btn-outline-secondary me-1" disabled>
                <i class="bi bi-type-bold"></i>
              </button>
              <button class="btn btn-sm btn-outline-secondary me-1" disabled>
                <i class="bi bi-type-italic"></i>
              </button>
              <button class="btn btn-sm btn-outline-secondary" disabled>
                <i class="bi bi-link-45deg"></i>
              </button>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Privacy notice -->
      <div class="mt-3 text-center text-muted small">
        <i class="bi bi-shield-lock me-1"></i>
        Your conversations are end-to-end encrypted and not stored on our servers.
      </div>
    </div>
  </div>
</div>

<!-- Add Bootstrap Icons -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">

<!-- Include the Socket.IO client library -->
<script src="/socket.io/socket.io.js"></script>

<!-- Include the SimplePeer library via CDN -->
<script src="https://cdn.jsdelivr.net/npm/simple-peer/simplepeer.min.js"></script>

<!-- Include WebRTCClient.js with a custom implementation of appendMessage -->
<script>
  // Create a placeholder function that will be replaced
  function appendMessage(sender, message) {
    console.log("Placeholder appendMessage called");
  }
</script>

<script src="/WebRTCClient.js"></script>

<script>
  document.addEventListener('DOMContentLoaded', function()
  {
      console.log('Text chat UI initializing');
      
      const startButton = document.getElementById('startButton');
      const endButton = document.getElementById('endButton');
      const statusMessage = document.getElementById('statusMessage');
      const chatBox = document.getElementById('chatBox');
      const messageInput = document.getElementById('messageInput');
      const sendButton = document.getElementById('sendButton');
      const formatButtons = document.querySelectorAll('.message-tools button, .text-format-tools button');
      
      console.log('Elements found:', {
          startButton: !!startButton,
          endButton: !!endButton,
          statusMessage: !!statusMessage,
          chatBox: !!chatBox,
          messageInput: !!messageInput,
          sendButton: !!sendButton
      });
      
      // Override the appendMessage function from WebRTCClient.js to use our chat UI
      window.appendMessage = function(sender, message) {
          console.log(`Custom appendMessage called with: ${sender}: ${message}`);
          
          // Remove welcome message if it exists
          const welcomeMessage = chatBox.querySelector('.welcome-message');
          if (welcomeMessage) {
              welcomeMessage.remove();
          }
          
          const messageElement = document.createElement('div');
          messageElement.className = sender === 'You' ? 'message-container sent' : 'message-container received';
          
          // Format the current time
          const now = new Date();
          const timeString = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
          
          messageElement.innerHTML = `
            <div class="message ${sender === 'You' ? 'message-sent' : 'message-received'}">
              <div class="message-content">${message}</div>
              <div class="message-meta">
                <span class="message-time">${timeString}</span>
                ${sender === 'You' ? '<i class="bi bi-check2-all"></i>' : ''}
              </div>
            </div>
          `;
          
          chatBox.appendChild(messageElement);
          // Scroll to the bottom of the chat box
          chatBox.scrollTop = chatBox.scrollHeight;
      };      // Fix the variable names to match what WebRTCClient.js is expecting
      // These need to be global variables
      window.chatInput = messageInput;
      window.chatSendButton = sendButton;
      window.chatMessages = chatBox;
      
      // Make sure global variables are accessible without window prefix
      // This is needed because WebRTCClient.js accesses these variables directly
      globalThis.chatInput = messageInput;
      globalThis.chatSendButton = sendButton;
      globalThis.chatMessages = chatBox;
      
      // Update UI status with icons
      function updateStatus(status, iconClass = 'bi-info-circle')
      {
          statusMessage.innerHTML = `<i class="${iconClass} me-2"></i>${status}`;
      }
      
      // Start button click handler
      startButton.addEventListener('click', async () =>
      {
          console.log('Start button clicked, joining matchmaking queue...');
          
          // Update status and disable button
          updateStatus('Looking for a chat partner...', 'bi-hourglass-split');
          statusMessage.classList.add('searching');
          startButton.disabled = true;

          try
          {
              // Call the join-queue endpoint
              const response = await fetch('/api/matchmaking/join-queue', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ socketId: mySocketId, topics: [] }) // Add topics if needed
              });

              if (!response.ok)
              {
                  throw new Error('Failed to join matchmaking queue');
              }

              console.log('Successfully joined matchmaking queue');

              // Wait for 10 seconds before calling delayed matchmaking
              setTimeout(async () =>
              {
                  console.log('10 seconds passed, calling delayed matchmaking...');

                  try
                  {
                      const delayedResponse = await fetch('/api/matchmaking/delayed-matchmaking', {
                          method: 'POST',
                          headers: { 'Content-Type': 'application/json' },
                          body: JSON.stringify({ socketId: mySocketId, topics: [] }) // Add topics if needed
                      });

                      if (!delayedResponse.ok)
                      {
                          throw new Error('Failed to perform delayed matchmaking');
                      }

                      console.log('Successfully called delayed matchmaking');
                  }
                  catch (error)
                  {
                      console.error('Error during delayed matchmaking:', error);
                      updateStatus(`Error: ${error.message}`, 'bi-exclamation-triangle');
                      startButton.disabled = false;
                      statusMessage.classList.remove('searching');
                  }
              }, 10000);
          }
          catch (error)
          {
              console.error('Error joining matchmaking queue:', error);
              updateStatus(`Error: ${error.message}`, 'bi-exclamation-triangle');
              startButton.disabled = false;
              statusMessage.classList.remove('searching');
          }
      });

      // End button click handler
      endButton.addEventListener('click', () =>
      {
          endCurrentChat();
      });

      // Function to end the current chat session
      function endCurrentChat()
      {
          // Reset UI state
          startButton.disabled = false;
          endButton.disabled = true;
          statusMessage.innerHTML = '';
          statusMessage.classList.remove('searching', 'connected');
          
          // Reset chat box
          chatBox.innerHTML = `
            <div class="welcome-message text-center p-4">
              <div class="mb-3">
                <i class="bi bi-chat-text fs-1 text-primary"></i>
              </div>
              <h5>Welcome to FreeYap Text Chat!</h5>
              <p class="text-muted">No messages yet. Start the conversation!</p>
            </div>
          `;
          
          // Disable message input
          messageInput.disabled = true;
          sendButton.disabled = true;
          formatButtons.forEach(button => button.disabled = true);
          
          // Destroy the WebRTC connection
          if (peer)
          {
              peer.destroy();
              peer = null;
          }
          partnerSocketId = null;
      }      // Add additional event handlers for sending messages
      
      // Handle Enter key press
      messageInput.addEventListener('keypress', (event) =>
      {
          if (event.key === 'Enter')
          {
              event.preventDefault(); // Prevent default form submission
              sendChatMessage();
          }
      });
      
      // Add our own click handler for the send button as a backup
      sendButton.addEventListener('click', () => {
          console.log('Send button clicked via our custom handler');
          sendChatMessage();
      });
      
      // Function to send messages that works with our UI
      function sendChatMessage()
      {
          const message = messageInput.value.trim();
          if (message && peer && !peer.destroyed)
          {
              console.log('Sending message:', message);
              peer.send(message);
              appendMessage('You', message);
              messageInput.value = ''; // Clear input after sending
          }
      }
        // Extend the WebRTCClient's setupPeer function for text chat
      const originalSetupPeer = window.setupPeer || function() {};
      
      window.setupPeer = function(p, toSocketId)
      {
          if (typeof originalSetupPeer === 'function')
          {
              originalSetupPeer(p, toSocketId);
          }
          
          // Add our custom text chat functionality
          p.on('connect', () =>
          {
              console.log('Peer connection established');
              
              // Enable UI for active chat
              endButton.disabled = false;
              messageInput.disabled = false;
              sendButton.disabled = false;
              formatButtons.forEach(button => button.disabled = false);
              
              // Update status
              updateStatus('Connected! Chat session started.', 'bi-check-circle-fill');
              statusMessage.classList.remove('searching');
              statusMessage.classList.add('connected');
          });
          
          p.on('close', () =>
          {
              console.log('Peer connection closed');
              endCurrentChat();
          });
          
          p.on('error', err =>
          {
              console.error('Peer connection error:', err);
              updateStatus(`Error: ${err.message}`, 'bi-exclamation-triangle');
              endCurrentChat();
          });
          
          return p;
      };
  });
</script>
