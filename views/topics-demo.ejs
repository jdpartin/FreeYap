<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <h1>Topics Integration Demo</h1>
            <p class="lead">This page demonstrates the topics widget working independently from chat functionality</p>
        </div>
    </div>
    
    <div class="row mt-4">
        <!-- Topics Widget Section -->
        <div class="col-lg-5">
            <div class="card mb-4">
                <div class="card-header">
                    <h3>Topics Widget</h3>
                    <p class="text-muted mb-0">Independently manages topic display and similarity analysis</p>
                </div>
                <div class="card-body">
                    <!-- Topics container will be rendered here -->
                    <div id="topics-container" class="topics-container">
                        <div class="user-topics">
                            <h3>Your Topics</h3>
                            <div id="user-topics-list"></div>
                        </div>
                        <div class="partner-topics">
                            <h3 id="partner-topics-header">Partner's Topics</h3>
                            <div id="partner-topics-list">
                                <div class="topics-empty">Waiting for partner...</div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Topics Control Panel -->
                    <div class="card">
                        <div class="card-header">Topics Controls</div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label for="user-topics-input" class="form-label">Update Your Topics</label>
                                <div class="input-group">
                                    <input type="text" class="form-control" id="user-topics-input" 
                                           placeholder="e.g. Programming, Music, Travel">
                                    <button class="btn btn-primary" id="set-user-topics-btn">Update Topics</button>
                                </div>
                                <div class="form-text">Enter comma-separated topics</div>
                            </div>
                            
                            <div class="mb-3">
                                <label for="partner-topics-input" class="form-label">Test Partner Topics</label>
                                <div class="input-group">
                                    <input type="text" class="form-control" id="partner-topics-input" 
                                           placeholder="e.g. Technology, Photography, Hiking">
                                    <button class="btn btn-outline-secondary" id="simulate-partner-topics-btn">Simulate</button>
                                </div>
                                <div class="form-text">For testing only - simulates receiving partner topics</div>
                            </div>
                            
                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" id="smart-hello-switch" checked>
                                <label class="form-check-label" for="smart-hello-switch">Enable Smart Hello</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Chat Widget Section -->
        <div class="col-lg-7">
            <div class="card mb-4">
                <div class="card-header">
                    <h3 id="chat-session-title">
                        <i class="bi bi-chat-dots-fill me-2"></i>Chat Session
                    </h3>
                </div>
                <div class="card-body p-0">
                    <div class="chat-interface">
                        <div id="chat-messages" class="chat-messages"></div>
                        
                        <div id="chat-suggestions" class="chat-suggestions" style="display: none;"></div>
                        
                        <div class="chat-input-container">
                            <input type="text" id="chat-input" class="form-control" placeholder="Type a message...">
                            <button id="chat-send" class="btn btn-primary">Send</button>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Connection Status & Info -->
            <div class="card">
                <div class="card-header">Connection Status</div>
                <div class="card-body">
                    <div id="connection-status" class="alert alert-secondary">
                        Not connected to a partner
                    </div>
                    <div id="similarity-info" class="d-none">
                        <h5>Topic Similarity Analysis</h5>
                        <pre id="similarity-data" class="bg-light p-3 rounded small" style="max-height: 150px; overflow-y: auto;">No data yet</pre>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add CSS for the demo page -->
<style>
    .chat-messages {
        height: 350px;
        overflow-y: auto;
        padding: 15px;
        background-color: white;
        border-bottom: 1px solid #dee2e6;
    }
    
    .chat-input-container {
        display: flex;
        padding: 15px;
        background-color: #f8f9fa;
    }
    
    #chat-input {
        margin-right: 10px;
    }
    
    .chat-message {
        margin-bottom: 10px;
    }
    
    .chat-sender-self {
        font-weight: bold;
        color: #007bff;
    }
    
    .chat-sender-partner {
        font-weight: bold;
        color: #6f42c1;
    }
    
    .topics-container {
        background-color: #f8f9fa;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 20px;
    }
    
    .user-topics, .partner-topics {
        margin-bottom: 15px;
    }
    
    .topic-bubble {
        display: inline-block;
        background-color: #e9ecef;
        border-radius: 20px;
        padding: 5px 12px;
        margin: 3px;
        font-size: 14px;
        animation: fadeIn 0.3s ease-in-out;
        border-left: 4px solid transparent;
    }
    
    .topic-bubble.new-topic {
        animation: popIn 0.4s ease-out;
    }
    
    .topics-empty {
        color: #6c757d;
        font-style: italic;
        font-size: 14px;
    }
    
    .chat-suggestions {
        background-color: #f0f7ff;
        border-radius: 0;
        padding: 12px;
    }
    
    .suggestion-pill {
        display: inline-block;
        background-color: white;
        border: 1px solid #b8daff;
        border-radius: 20px;
        padding: 5px 12px;
        margin: 3px;
        cursor: pointer;
        font-size: 13px;
        transition: background-color 0.2s;
    }
    
    .suggestion-pill:hover {
        background-color: #e6f2ff;
    }
    
    @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }
    
    @keyframes popIn {
        0% { transform: scale(0.7); opacity: 0; }
        70% { transform: scale(1.05); }
        100% { transform: scale(1); opacity: 1; }
    }
</style>

<!-- Socket.io and SimplePeer dependencies -->
<script src="/socket.io/socket.io.js"></script>
<script src="https://cdn.jsdelivr.net/npm/simple-peer@9.11.1/simplepeer.min.js"></script>

<!-- Main WebRTC Modules -->
<script src="/js/WebRTCCore.js"></script>
<script src="/js/WebRTCChatWidget.js"></script>
<script src="/js/WebRTCTopicsWidget.js"></script>
<script src="/js/WebRTCIntegration.js"></script>
<script src="/js/WebRTCWidgetLoader.js"></script>

<!-- Demo-specific script -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Wait for WebRTC modules to be loaded
        const checkModules = () => {
            if (window.webrtcCore) {
                initializeDemo();
            } else {
                setTimeout(checkModules, 100);
            }
        };
        
        // Initialize the demo page
        function initializeDemo() {
            console.log('Initializing topics integration demo');
            
            // Create chat widget
            window.chatWidget = new WebRTCChatWidget({
                chatInputId: 'chat-input',
                chatSendButtonId: 'chat-send',
                chatMessagesId: 'chat-messages',
                chatTitleId: 'chat-session-title'
            });
            
            // Create topics widget with decoupled configuration
            window.topicsWidget = new WebRTCTopicsWidget({
                userTopicsListId: 'user-topics-list',
                partnerTopicsListId: 'partner-topics-list',
                partnerTopicsHeaderId: 'partner-topics-header',
                topicsContainerId: 'topics-container',
                enableSmartHello: true,
                smartHelloChannel: 'chat',
                onTopicSimilarityCalculated: handleTopicSimilarity
            });
            
            // Setup event listeners
            setupUIHandlers();
            setupConnectionStatusTracking();
        }
        
        // Handle topic similarity data
        function handleTopicSimilarity(data) {
            console.log('Topic similarity data:', data);
            
            // Show the similarity info section
            document.getElementById('similarity-info').classList.remove('d-none');
            
            // Format and display the similarity data
            const { similarities, topMatch, secondMatch } = data;
            
            if (similarities && similarities.length > 0) {
                let output = `${similarities.length} topic pairs analyzed\n\n`;
                
                if (topMatch) {
                    output += `Top match: "${topMatch.userTopic}" and "${topMatch.partnerTopic}"\n`;
                    output += `Similarity: ${topMatch.similarityPercentage}%\n\n`;
                }
                
                output += `Top similarities:\n`;
                similarities.slice(0, 5).forEach((sim, i) => {
                    output += `${i+1}. "${sim.userTopic}" - "${sim.partnerTopic}": ${sim.similarityPercentage}%\n`;
                });
                
                document.getElementById('similarity-data').textContent = output;
                
                // Generate chat suggestions based on topic similarities
                generateChatSuggestions(data);
            }
        }
        
        // Generate and display chat suggestions based on topic similarity
        function generateChatSuggestions(data) {
            const { similarities, topMatch, secondMatch } = data;
            
            if (!topMatch) return;
            
            const suggestionContainer = document.getElementById('chat-suggestions');
            suggestionContainer.innerHTML = '<div class="suggestions-title mb-2">Topic suggestions:</div>';
            suggestionContainer.style.display = 'block';
            
            // Create suggestions based on similarity results
            const createSuggestion = (text) => {
                const pill = document.createElement('span');
                pill.className = 'suggestion-pill';
                pill.textContent = text;
                pill.addEventListener('click', () => {
                    const chatInput = document.getElementById('chat-input');
                    chatInput.value = text;
                    chatInput.focus();
                });
                suggestionContainer.appendChild(pill);
            };
            
            // Add suggestions based on match strength
            if (topMatch.similarity > 0.7) {
                createSuggestion(`I'm also really interested in ${topMatch.partnerTopic}! What aspects do you enjoy most?`);
            } else if (topMatch.similarity > 0.4) {
                createSuggestion(`I see you're into ${topMatch.partnerTopic}. How does that relate to ${topMatch.userTopic}?`);
            } else {
                createSuggestion(`What got you interested in ${topMatch.partnerTopic}?`);
            }
            
            // Additional suggestion
            if (secondMatch) {
                createSuggestion(`Tell me more about your interest in ${secondMatch.partnerTopic}`);
            }
            
            // Hide suggestions after 30 seconds
            setTimeout(() => {
                suggestionContainer.style.display = 'none';
            }, 30000);
        }
        
        // Setup UI event handlers
        function setupUIHandlers() {
            // Set user topics button
            document.getElementById('set-user-topics-btn').addEventListener('click', function() {
                const topicsInput = document.getElementById('user-topics-input').value;
                if (topicsInput && window.topicsWidget) {
                    const topics = topicsInput.split(',').map(t => t.trim()).filter(t => t);
                    if (topics.length > 0) {
                        window.topicsWidget.setUserTopics(topics);
                    }
                }
            });
            
            // Simulate partner topics button
            document.getElementById('simulate-partner-topics-btn').addEventListener('click', function() {
                const topicsInput = document.getElementById('partner-topics-input').value;
                if (topicsInput && window.topicsWidget) {
                    const topics = topicsInput.split(',').map(t => t.trim()).filter(t => t);
                    if (topics.length > 0) {
                        // This simulates receiving topics from a partner
                        window.topicsWidget._handleIncomingTopics({ topics });
                    }
                }
            });
            
            // Smart hello toggle switch
            document.getElementById('smart-hello-switch').addEventListener('change', function(e) {
                if (window.topicsWidget) {
                    window.topicsWidget.enableSmartHello = e.target.checked;
                }
            });
        }
        
        // Track connection status
        function setupConnectionStatusTracking() {
            const statusEl = document.getElementById('connection-status');
            
            // Add event listeners to WebRTCCore for connection status
            if (window.webrtcCore) {
                // Connection established
                window.webrtcCore.addEventListener('peerConnected', () => {
                    statusEl.className = 'alert alert-success';
                    statusEl.innerHTML = `<i class="bi bi-person-check-fill me-2"></i> Connected to ${window.webrtcCore.getPartnerName()}`;
                });
                
                // Connection closed
                window.webrtcCore.addEventListener('peerClosed', () => {
                    statusEl.className = 'alert alert-secondary';
                    statusEl.textContent = 'Not connected to a partner';
                    
                    // Hide similarity info
                    document.getElementById('similarity-info').classList.add('d-none');
                    
                    // Hide chat suggestions
                    document.getElementById('chat-suggestions').style.display = 'none';
                });
                
                // Connection error
                window.webrtcCore.addEventListener('peerError', (error) => {
                    statusEl.className = 'alert alert-danger';
                    statusEl.textContent = 'Connection error';
                    console.error('WebRTC error:', error);
                });
            }
        }
        
        // Start checking for modules
        checkModules();
    });
</script>
