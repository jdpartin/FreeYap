<!-- Topics Widget Component -->
<div id="topics-container" class="topics-container">
    <div class="user-topics">
        <h3>Your Topics</h3>
        <div id="user-topics-list"></div>
    </div>
    <div class="partner-topics">
        <h3 id="partner-topics-header">Partner's Topics</h3>
        <div id="partner-topics-list">
            <div class="topics-empty">Waiting for partner...</div>
        </div>
    </div>
</div>

<!-- JavaScript to initialize the topics widget -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Wait for WebRTCCore to be initialized
        const initTopicsWidget = function() {
            if (window.webrtcCore && typeof WebRTCTopicsWidget !== 'undefined') {
                // Initialize topics widget if it doesn't exist yet
                if (!window.topicsWidget) {
                    console.log('Initializing topics widget component');
                    
                    window.topicsWidget = new WebRTCTopicsWidget({
                        // You can customize options here
                        enableSmartHello: true, 
                        onTopicSimilarityCalculated: function(data) {
                            // Custom handler for topic similarity data
                            console.log('Topics similarity data:', data);
                            
                            // Example: Dispatch custom event that other components can listen for
                            const event = new CustomEvent('topicSimilarityCalculated', { 
                                detail: data 
                            });
                            document.dispatchEvent(event);
                        }
                    });
                }
            } else {
                // Retry after a short delay if WebRTCCore or WebRTCTopicsWidget isn't loaded yet
                setTimeout(initTopicsWidget, 100);
            }
        };
        
        // Start initialization
        initTopicsWidget();
    });
</script>

<!-- Optional CSS for topics widget -->
<style>
    .topics-container {
        background-color: #f8f9fa;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 20px;
    }
    
    .user-topics, .partner-topics {
        margin-bottom: 15px;
    }
    
    .user-topics h3, .partner-topics h3 {
        font-size: 16px;
        margin-bottom: 10px;
    }
    
    .topic-bubble {
        display: inline-block;
        background-color: #e9ecef;
        border-radius: 20px;
        padding: 5px 12px;
        margin: 3px;
        font-size: 14px;
        animation: fadeIn 0.3s ease-in-out;
        border-left: 4px solid transparent;
    }
    
    .topic-bubble.new-topic {
        animation: popIn 0.4s ease-out;
    }
    
    .topics-empty {
        color: #6c757d;
        font-style: italic;
        font-size: 14px;
    }
    
    .similarity-legend {
        margin-top: 15px;
        font-size: 12px;
        border-top: 1px solid #dee2e6;
        padding-top: 10px;
    }
    
    .legend-title {
        font-weight: bold;
        margin-bottom: 5px;
    }
    
    .legend-items {
        display: flex;
        flex-wrap: wrap;
    }
    
    .legend-item {
        display: flex;
        align-items: center;
        margin-right: 15px;
        margin-bottom: 5px;
    }
    
    .legend-color {
        width: 12px;
        height: 12px;
        display: inline-block;
        margin-right: 5px;
    }
    
    @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }
    
    @keyframes popIn {
        0% { transform: scale(0.7); opacity: 0; }
        70% { transform: scale(1.05); }
        100% { transform: scale(1); opacity: 1; }
    }
</style>
