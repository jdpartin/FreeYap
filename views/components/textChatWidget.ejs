<!-- Text Chat Widget Component -->
<!-- 
  This is a modular text chat widget that can be embedded in any page.
  
  Usage:
  <%- include('components/textChatWidget', { 
    widgetId: 'unique-id', 
    showTopics: true,
    enableEmoji: true,
    enableGif: true,
    enableVoiceRecording: false,
    customClasses: 'additional-css-classes'
  }) %>
-->

<%
  // Set default values for parameters
  const widgetId = locals.widgetId || 'text-chat-widget';
  const showTopics = locals.showTopics !== false; // default true
  const enableEmoji = locals.enableEmoji !== false; // default true
  const enableGif = locals.enableGif !== false; // default true
  const enableVoiceRecording = locals.enableVoiceRecording || false; // default false
  const customClasses = locals.customClasses || '';
  const containerHeight = locals.containerHeight || '70vh';
%>

<div class="text-chat-widget <%= customClasses %>" id="<%= widgetId %>" data-widget-id="<%= widgetId %>">
  <!-- Include text chat specific styles -->
  <link href="/textChat.css" rel="stylesheet">
  <link href="/textChatMedia.css" rel="stylesheet">

  <div class="text-chat-container">
    <% if (showTopics) { %>
    <!-- Topics Display -->
    <div class="topics-display">
      <div class="topics-section user-topics">
        <div class="topics-title">
          <i class="fas fa-user"></i>
          Your Topics
        </div>
        <div class="topics-list" id="<%= widgetId %>-user-topics-list">
          <div class="topics-empty">No topics selected</div>
        </div>
      </div>
      <div class="topics-section partner-topics">
        <div class="topics-title">
          <i class="fas fa-users"></i>
          <span id="<%= widgetId %>-partner-topics-header">Partner's Topics</span>
        </div>
        <div class="topics-list" id="<%= widgetId %>-partner-topics-list">
          <div class="topics-empty">Waiting for partner...</div>
        </div>
      </div>
    </div>
    <% } %>

    <!-- Main Chat Card -->
    <div class="card shadow-sm chat-card" style="height: <%= containerHeight %>;">
      <!-- Chat header with controls -->
      <div class="card-header text-white d-flex justify-content-between align-items-center" style="background-color: var(--primary);">
        <span id="<%= widgetId %>-chat-session-title">
          <i class="bi bi-chat-dots-fill me-2"></i>Chat Session
          <i class="bi bi-info-circle ms-2 chat-info-icon" 
             title="This is a randomly generated name to help you connect personally while staying anonymous" 
             style="cursor: help; display: none;"></i>
        </span>
        <div class="chat-controls">
          <button id="<%= widgetId %>-startButton" class="btn btn-sm btn-light me-1">
            <i class="bi bi-play-fill"></i> Start
          </button>
          <button id="<%= widgetId %>-endButton" class="btn btn-sm btn-danger" disabled>
            <i class="bi bi-x-lg"></i> End
          </button>
        </div>
      </div>
      
      <!-- Chat messages area -->
      <div class="card-body p-0">
        <div class="chat-box" id="<%= widgetId %>-chatBox">
          <div class="welcome-message text-center p-4">
            <div class="mb-3">
              <i class="bi bi-chat-text fs-1" style="color: var(--primary);"></i>
            </div>
            <h5>Welcome to FreeYap Text Chat!</h5>
            <p class="text-muted">No messages yet. Start the conversation!</p>
          </div>
        </div>
      </div>

      <!-- Status message -->
      <div id="<%= widgetId %>-statusMessage" class="text-center bg-light border-top border-bottom status-bar"></div>

      <!-- Message input area -->
      <div class="card-footer p-2">
        <div class="input-group">
          <% if (enableEmoji) { %>
          <button class="btn btn-outline-secondary emoji-button me-2" id="<%= widgetId %>-emojiButton" disabled>
            <i class="bi bi-emoji-smile"></i>
          </button>
          <% } %>
          <input type="text" class="form-control" placeholder="Type your message here..." id="<%= widgetId %>-messageInput" disabled>
          <button class="btn" id="<%= widgetId %>-sendButton" style="background-color: var(--primary); color: white;" disabled>
            <i class="bi bi-send-fill"></i>
          </button>
        </div>

        <% if (enableEmoji || enableGif) { %>
        <!-- Emoji and GIF Panel -->
        <div class="emoji-gif-panel d-none" id="<%= widgetId %>-emojiGifPanel">
          <ul class="nav nav-tabs" id="<%= widgetId %>-emojiGifTabs">
            <% if (enableEmoji) { %>
            <li class="nav-item">
              <button class="nav-link active" id="<%= widgetId %>-emoji-tab" data-bs-toggle="tab" data-bs-target="#<%= widgetId %>-emoji-pane">
                <i class="bi bi-emoji-smile"></i> Emoji
              </button>
            </li>
            <% } %>
            <% if (enableGif) { %>
            <li class="nav-item">
              <button class="nav-link" id="<%= widgetId %>-gif-tab" data-bs-toggle="tab" data-bs-target="#<%= widgetId %>-gif-pane">
                <i class="bi bi-filetype-gif"></i> GIF
              </button>
            </li>
            <% } %>
          </ul>
          <div class="tab-content" id="<%= widgetId %>-emojiGifTabContent">
            <% if (enableEmoji) { %>
            <div class="tab-pane fade show active" id="<%= widgetId %>-emoji-pane">
              <div class="emoji-categories p-3">
                <div class="emoji-category">
                  <h6>Smileys & Emotion</h6>
                  <div class="emoji-grid" id="<%= widgetId %>-emoji-smileys">
                    <!-- Emoji will be populated by JavaScript -->
                  </div>
                </div>
              </div>
            </div>
            <% } %>
            <% if (enableGif) { %>
            <div class="tab-pane fade" id="<%= widgetId %>-gif-pane">
              <div class="gif-search p-3">
                <input type="text" class="form-control mb-3" placeholder="Search GIFs..." id="<%= widgetId %>-gifSearch">
                <div class="gif-results" id="<%= widgetId %>-gifResults">
                  <!-- GIFs will be populated by JavaScript -->
                </div>
              </div>
            </div>
            <% } %>
          </div>
        </div>
        <% } %>

        <% if (enableVoiceRecording) { %>
        <!-- Voice Recording UI -->
        <div class="utility-panel voice-recorder-ui d-none" id="<%= widgetId %>-voiceRecorderUI">
          <div class="panel-header">
            <h6><i class="bi bi-mic-fill me-2"></i>Voice Recording</h6>
            <button class="btn-close btn-sm" aria-label="Close"></button>
          </div>
          <div class="voice-recorder-container text-center">
            <div class="voice-recorder-timer mb-2" id="<%= widgetId %>-voiceTimer">00:00</div>
            <div class="voice-recorder-visualizer mb-3" id="<%= widgetId %>-voiceVisualizer">
              <div class="visualizer-bar"></div>
              <div class="visualizer-bar"></div>
              <div class="visualizer-bar"></div>
              <div class="visualizer-bar"></div>
              <div class="visualizer-bar"></div>
            </div>
            <div class="voice-recorder-controls">
              <button class="btn btn-danger btn-circle me-2" id="<%= widgetId %>-voiceRecordButton">
                <i class="bi bi-mic-fill"></i>
              </button>
              <button class="btn btn-secondary btn-circle me-2 d-none" id="<%= widgetId %>-voiceStopButton">
                <i class="bi bi-stop-fill"></i>
              </button>
              <button class="btn btn-success btn-circle me-2 d-none" id="<%= widgetId %>-voiceSendButton">
                <i class="bi bi-send-fill"></i>
              </button>
              <button class="btn btn-outline-secondary btn-circle" id="<%= widgetId %>-voiceCancelButton">
                <i class="bi bi-x-lg"></i>
              </button>
            </div>
          </div>
        </div>
        <% } %>
      </div>
    </div>

    <!-- Privacy notice -->
    <div class="mt-3 text-center text-muted small">
      <i class="bi bi-shield-lock me-1"></i>
      Your conversations are end-to-end encrypted and not stored on our servers.
    </div>
  </div>
</div>

<!-- Include required JavaScript modules -->
<script src="/js/textChat/textChatCore.js"></script>
<script src="/js/textChat/textChatTopics.js"></script>
<script src="/js/textChat/textChatEmoji.js"></script>
<script src="/js/textChat/textChatMedia.js"></script>
<script src="/js/textChat/textChatInit.js"></script>
<script>
  // Set widget configuration as a global variable
  window.textChatWidgetConfig = window.textChatWidgetConfig || {};
  window.textChatWidgetConfig['<%= widgetId %>'] = {
    showTopics: <%= showTopics %>,
    enableEmoji: <%= enableEmoji %>,
    enableGif: <%= enableGif %>,
    enableVoiceRecording: <%= enableVoiceRecording %>
  };
</script>