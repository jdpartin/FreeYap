<link href="/css/voice-chat-widget.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

<div class="container p-0">
    <div id="voice-container" class="layout-default">

        <!-- Bottom bar for voice chat title and layout controls (Now its a top bar) -->
        <div id="bottom-bar" class="text-white d-flex justify-content-between align-items-center">            <span id="chat-session-title">
                <img src="/images/logo_white.png" class="logo-image" alt="FreeYap Logo"> FreeYap.com
            </span>

            <!-- Voice effect controls on the left - HIDDEN FOR NOW -->
            <div id="voice-effects" class="d-flex align-items-center">
                <button class="effect-btn" title="Voice Effects"  style="display:none;">
                    <i class="fas fa-bullhorn"></i>
                </button>
            </div>
            
        </div>

        <!-- Audio visualizer -->
        <div id="audio-visualizer">
            <div class="audio-wrapper">
                <label>Local Audio</label>
                <audio id="local-audio" autoplay muted></audio>
                <div class="audio-icon-container">
                    <i class="fas fa-microphone audio-icon"></i>
                </div>
            </div>
            <div class="audio-wrapper">
                <label>Remote Audio</label>
                <audio id="remote-audio" autoplay></audio>
                <div class="audio-icon-container">
                    <i class="fas fa-microphone audio-icon"></i>
                </div>
            </div>
        </div>
          <!-- Effect menus container -->
        <div id="effect-menus-container">
            <!-- Voice Effects Menu -->
            <div id="voice-effects-menu" class="effect-menu">
                <div class="effect-menu-header">
                    <h5>Voice Effects</h5>
                    <button class="close-menu-btn"><i class="fas fa-times"></i></button>
                </div>
                <div class="effect-menu-content">
                    <div class="effect-category">
                        <h6>Voice Changers</h6>
                        <div class="effect-options">
                            <div class="effect-option active" data-effect="none">
                                <div class="effect-preview voice-normal"></div>
                                <span>Normal</span>
                            </div>
                            <div class="effect-option" data-effect="deep">
                                <div class="effect-preview voice-deep"></div>
                                <span>Deep</span>
                            </div>
                            <div class="effect-option" data-effect="high">
                                <div class="effect-preview voice-high"></div>
                                <span>High</span>
                            </div>
                            <div class="effect-option" data-effect="robot">
                                <div class="effect-preview voice-robot"></div>
                                <span>Robot</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bottom controls bar with simplified layout -->
        <div id="bottom-controls-bar" class="d-flex flex-column">
            <!-- Voice controls in white section -->
            <div id="voice-controls" class="white-section">
                <button id="start-voice-btn" class="control-btn d-none" title="Start Voice Chat">
                    <i class="fas fa-phone"></i>
                </button>
                <button id="stop-voice-btn" class="control-btn d-none" title="Stop Voice">
                    <i class="fas fa-phone-slash"></i>
                </button>
                <button id="mute-audio-btn" class="control-btn" title="Toggle Audio">
                    <i class="fas fa-microphone"></i>
                </button>
                <button id="settings-btn" class="control-btn d-none" title="Settings">
                    <i class="fas fa-cog"></i>
                </button>
            </div>
        </div>        
        
    </div>
</div>

<script src="/js/widgets/voiceChatWidget.js"></script>
