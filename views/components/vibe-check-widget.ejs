<link href="/css/vibe-check-widget.css" rel="stylesheet">

<!-- Vibe Check Button -->
<button id="vibe-check-button" class="btn btn-primary btn-sm vibe-check-btn" title="Report content type for queue optimization" disabled>
    <i class="icon-vibe-check"></i> Vibe Check
</button>

<!-- Vibe Check Form -->
<div id="vibe-check-form" class="vibe-check-form hidden">
    <div class="card shadow-sm">
        <div class="card-header text-white" style="font-size:1.7em;background-color:var(--primary);">
            <h6 class="mb-0">
                <i class="icon-vibe-check"></i>
                Vibe Check
            </h6>        </div>        
        <div class="card-body">
            <p class="text-muted mb-3" style="font-size: 0.85rem; opacity: 0.7;">
                <i class="fas fa-info-circle me-1"></i>
                Vibe checks help us redirect users to the correct queue.<br>This is not a report and will never result in a ban.
            </p>
            <form id="vibe-check-report-form">                
                  <!-- Content Type Selection -->
                <div class="mb-3">
                    <div class="content-options">

                        <select class="form-select" id="vibe-check-interaction" required>
                            <option value="" disabled selected>-- Select Interaction --</option>
                            <!-- Will be filled dynamically with js -->
                        </select>
                        <br>                        <label class="form-check-container" for="nudity">
                            <input class="form-check-input" type="checkbox" name="nudity" id="nudity" value="on">
                            <div class="form-check-content">
                                <div class="content-type-option">
                                    <i class="bi bi-eye-slash" style="color:var(--primary);vertical-align:middle;"></i>
                                    <strong>Nudity</strong>
                                </div>
                            </div>
                        </label>
                        <label class="form-check-container" for="gore">
                            <input class="form-check-input" type="checkbox" name="gore" id="gore" value="on">
                            <div class="form-check-content">
                                <div class="content-type-option">
                                    <i class="fas fa-skull" style="color:var(--primary);vertical-align:middle;"></i>
                                    <strong>Gore</strong>
                                </div>
                            </div>
                        </label>
                    </div>                
                </div>
                <!-- Action Buttons -->                
                 <div class="d-flex justify-content-between mt-3">
                    <button type="button" id="cancel-vibe-check" class="btn btn-outline-secondary">
                        <i class="fas fa-times me-1"></i>Cancel
                    </button>
                    <button type="submit" id="submit-vibe-check" class="btn btn-primary" style="background-color: var(--primary); border-color: var(--primary);">
                        <i class="fas fa-paper-plane me-1"></i>Submit
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Background Overlay -->
<div id="vibe-check-overlay" class="hidden">
</div>

<!-- Vibe Check Confirmation Modal -->
<div id="vibe-check-confirmation" class="vibe-check-modal hidden">
    <div class="modal-overlay"></div>
    <div class="modal-content">
        <div class="text-center">
            <div class="success-icon">
                <i class="fas fa-check-circle text-success"></i>
            </div>            <h5 class="mt-3 mb-2">Submitted</h5>
            <p class="text-muted">Thank you for your feedback.</p>
            <button type="button" id="close-vibe-confirmation" class="btn btn-primary mt-2">
                <i class="fas fa-check me-1"></i>Done
            </button>
        </div>
    </div>
</div>

<script src="/js/widgets/vibeCheckWidget.js"></script>