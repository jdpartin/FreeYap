<link href="/css/video-chat-widget.css" rel="stylesheet">
<!--
<link href="/css/video-settings.css" rel="stylesheet">
<link href="/css/video-effects.css" rel="stylesheet">
-->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

<div class="container p-0">
    <div id="video-container" class="layout-default">
        
        <!-- Bottom bar for video chat title and layout controls -->
        <div id="bottom-bar" class="text-white d-flex align-items-center">
            <!-- Column for video effect controls -->
            <div id="video-effects" class="d-flex flex-column align-items-start">
                <div class="d-flex flex-row">                    
                    <span id="chat-session-title">
                        <i class="icon-logo logo-image"></i>FreeYap.com
                    </span>
                    <button class="effect-btn" title="Backgrounds/Filters" style="display:none;">
                        <i class="fas fa-magic"></i>
                    </button>
                    <button class="effect-btn" title="Avatars" style="display:none;">
                        <i class="fas fa-user-circle"></i>
                    </button>
                    <button class="effect-btn" title="Voice Effects" style="display:none;">
                        <i class="fas fa-bullhorn"></i>
                    </button>
                </div>
            </div>

            <!-- Column for Vibe Check Widget -->
            <div id="vibe-check" class="d-flex flex-column align-items-center">
                <div class="d-flex flex-row align-items-center">
                    <!-- The vibe check widget is automatically being initialized 
                         in the video chat widget class constructor -->
                    <%- include('./vibe-check-widget') %>
                </div>
            </div>

            <!-- Column for layout controls -->
            <div id="layout-controls" class="d-flex flex-column align-items-end">
                <div class="d-flex flex-row">
                    <button class="layout-btn active" data-layout="default" title="Default Layout">
                        <i class="fas fa-th-large"></i>
                    </button>
                    <button class="layout-btn" data-layout="pip" title="Picture in Picture">
                        <i class="fas fa-clone"></i>
                    </button>
                </div>
            </div>
            
        </div>        <!-- Main video area -->
        <div id="videos">
            <div class="video-wrapper local-wrapper">
                <video id="local-video" autoplay muted playsinline webkit-playsinline></video>
            </div>
            <div class="video-wrapper remote-wrapper">
                <video id="remote-video" autoplay playsinline webkit-playsinline></video>
            </div>        
        </div>
        
        <!-- Effect menus containers --->
        <div id="effect-menus-container" style="display:none;">
            <!-- Background/Filters Menu -->
            <div id="backgrounds-filters-menu" class="effect-menu">
                <div class="effect-menu-header">
                    <h5>Backgrounds & Filters</h5>
                    <button class="close-menu-btn"><i class="fas fa-times"></i></button>
                </div>
                <div class="effect-menu-content">
                    <div class="effect-category">
                        <h6>Backgrounds</h6>
                        <div class="effect-options">
                            <div class="effect-option" data-effect="blur">
                                <div class="effect-preview blur-bg"></div>
                                <span>Blur</span>
                            </div>
                            <div class="effect-option" data-effect="office">
                                <div class="effect-preview office-bg"></div>
                                <span>Office</span>
                            </div>
                            <div class="effect-option" data-effect="beach">
                                <div class="effect-preview beach-bg"></div>
                                <span>Beach</span>
                            </div>
                            <div class="effect-option" data-effect="space">
                                <div class="effect-preview space-bg"></div>
                                <span>Space</span>
                            </div>
                        </div>
                    </div>
                    <div class="effect-category">
                        <h6>Video Filters</h6>
                        <div class="effect-options">
                            <div class="effect-option" data-effect="none">
                                <div class="effect-preview no-filter"></div>
                                <span>None</span>
                            </div>
                            <div class="effect-option" data-effect="vintage">
                                <div class="effect-preview vintage-filter"></div>
                                <span>Vintage</span>
                            </div>
                            <div class="effect-option" data-effect="grayscale">
                                <div class="effect-preview grayscale-filter"></div>
                                <span>B&W</span>
                            </div>
                            <div class="effect-option" data-effect="sepia">
                                <div class="effect-preview sepia-filter"></div>
                                <span>Sepia</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Avatars Menu -->
            <div id="avatars-menu" class="effect-menu">
                <div class="effect-menu-header">
                    <h5>Avatars</h5>
                    <button class="close-menu-btn"><i class="fas fa-times"></i></button>
                </div>
                <div class="effect-menu-content">
                    <div class="effect-category">
                        <h6>Character Avatars</h6>
                        <div class="effect-options">
                            <div class="effect-option" data-effect="avatar1">
                                <div class="effect-preview avatar-1"></div>
                                <span>Cartoon</span>
                            </div>
                            <div class="effect-option" data-effect="avatar2">
                                <div class="effect-preview avatar-2"></div>
                                <span>Pixel</span>
                            </div>
                            <div class="effect-option" data-effect="avatar3">
                                <div class="effect-preview avatar-3"></div>
                                <span>Animal</span>
                            </div>
                            <div class="effect-option" data-effect="avatar4">
                                <div class="effect-preview avatar-4"></div>
                                <span>Robot</span>
                            </div>
                        </div>
                    </div>
                    <div class="effect-category">
                        <h6>Facial Features</h6>
                        <div class="effect-options">
                            <div class="effect-option" data-effect="hat">
                                <div class="effect-preview hat-feature"></div>
                                <span>Hat</span>
                            </div>
                            <div class="effect-option" data-effect="glasses">
                                <div class="effect-preview glasses-feature"></div>
                                <span>Glasses</span>
                            </div>
                            <div class="effect-option" data-effect="mask">
                                <div class="effect-preview mask-feature"></div>
                                <span>Mask</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Voice Effects Menu -->
            <div id="voice-effects-menu" class="effect-menu">
                <div class="effect-menu-header">
                    <h5>Voice Effects</h5>
                    <button class="close-menu-btn"><i class="fas fa-times"></i></button>
                </div>
                <div class="effect-menu-content">
                    <div class="effect-category">
                        <h6>Voice Changers</h6>
                        <div class="effect-options">
                            <div class="effect-option active" data-effect="none">
                                <div class="effect-preview voice-normal"></div>
                                <span>Normal</span>
                            </div>
                            <div class="effect-option" data-effect="deep">
                                <div class="effect-preview voice-deep"></div>
                                <span>Deep</span>
                            </div>
                            <div class="effect-option" data-effect="high">
                                <div class="effect-preview voice-high"></div>
                                <span>High</span>
                            </div>
                            <div class="effect-option" data-effect="robot">
                                <div class="effect-preview voice-robot"></div>
                                <span>Robot</span>
                            </div>
                        </div>
                    </div>
                    <div class="effect-category">
                        <h6>Sound Effects</h6>
                        <div class="effect-options">
                            <div class="effect-option" data-effect="echo">
                                <div class="effect-preview echo-effect"></div>
                                <span>Echo</span>
                            </div>
                            <div class="effect-option" data-effect="reverb">
                                <div class="effect-preview reverb-effect"></div>
                                <span>Reverb</span>
                            </div>
                            <div class="effect-option" data-effect="noise-cancel">
                                <div class="effect-preview noise-cancel"></div>
                                <span>Noise Cancel</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Bottom controls bar with simplified layout options -->
        <div id="bottom-controls-bar" class="d-flex flex-column" >  
             <!-- Video controls in white section -->
            <div id="video-controls" class="white-section">
                <button id="mute-video-btn" class="control-btn" title="Toggle Video">
                    <i class="fas fa-video"></i>
                </button>
                <button id="mute-audio-btn" class="control-btn" title="Toggle Audio">
                    <i class="fas fa-microphone"></i>
                </button>
                <button id="share-screen-btn" class="control-btn" title="Share Screen" style="display:none;">
                    <i class="fas fa-desktop"></i>
                </button>
                <button id="settings-btn" class="control-btn" title="Settings" style="display:none;">
                    <i class="fas fa-cog"></i>
                </button>
            </div>
        </div>

    </div>
</div>

<script src="/js/widgets/videoChatWidget.js"></script>
<script src="/js/widgets/videoChatSettings.js"></script>