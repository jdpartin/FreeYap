<link href="/css/block-widget.css" rel="stylesheet">

<!-- Block Button -->
<button id="block-user-button" class="btn btn-danger btn-sm report-btn" title="Block this user" style="background-color: var(--primary); border-color: var(--primary);" disabled>
    <i class="fas fa-ban"></i>
</button>

<!-- Block Form -->
<div id="block-user-form" class="report-form hidden">
    <div class="card shadow-sm">        
        
        <div class="card-header text-white" style="background-color: var(--primary);">
            <h6 class="mb-0">
                <i class="fas fa-user-slash me-2"></i>
                Block User
            </h6>
        </div>        
        <div class="card-body">            
              <div class="warning-intro mb-3">
                <p class="text-muted mb-2">
                    <i class="fas fa-info-circle text-primary me-1"></i>
                    <strong>Block User:</strong> This creates a temporary block based on the user's current network connection. Due to our privacy-focused approach, blocks are not permanent and may not prevent all future encounters.
                </p>
            </div>
              <form id="block-user-submit-form">
                <div class="mb-3">
                    <label for="block-interaction" class="form-label fw-bold">Which user would you like to block?</label>
                    <select id="block-interaction" name="interaction" class="form-select" required>
                        <!-- Options will be populated dynamically -->
                    </select>
                </div>
                <!-- Block Notice -->
                <div class="mt-3">
                    <div class="alert alert-info" role="alert">
                        <i class="fas fa-info-circle me-1"></i>
                        <strong>Important:</strong> Blocks are temporary and network-based for privacy protection. We never store identifying information, so blocks expire automatically and may not be effective if users change networks or use VPNs.
                    </div>
                </div><!-- Action Buttons -->
                <div class="d-flex justify-content-between mt-3">
                    <button type="button" id="cancel-block-user" class="btn btn-outline-secondary">
                        <i class="fas fa-times me-1"></i>Cancel
                    </button>                    <button type="submit" id="submit-block-user" class="btn btn-danger" style="background-color: var(--primary); border-color: var(--primary);">
                        <i class="fas fa-ban me-1"></i>Block User
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Background Overlay -->
<div id="block-user-overlay" class="hidden">
</div>

<!-- Block Confirmation Modal -->
<div id="block-user-confirmation" class="report-modal hidden">
    <div class="modal-overlay"></div>
    <div class="modal-content">
        <div class="text-center">
            <div class="success-icon">
                <i class="fas fa-check-circle text-success"></i>
            </div>            <h5 class="mt-3 mb-2">User Blocked</h5>
            <p class="text-muted">
                A temporary block has been created for this user's current network connection. Due to our privacy-focused design, this block will automatically expire and may not prevent all future encounters.
            </p>
            <button type="button" id="close-block-confirmation" class="btn btn-primary mt-2">
                <i class="fas fa-check me-1"></i>Got It
            </button>
        </div>
    </div>
</div>

<script src="/js/widgets/blockWidget.js"></script>