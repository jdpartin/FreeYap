<link href="/css/text-chat-widget.css" rel="stylesheet">

<div class="container text-chat-container p-0">
    <div class="row justify-content-center">
        <div class="col-12">
            <div class="card shadow-sm chat-card">                <!-- Chat header with controls -->
                <div class="card-header text-white d-flex justify-content-between align-items-center chat-header">
                    <span id="chat-session-title">
                        <image src="/images/logo_white.png" class="logo-image"> FreeYap.com
                    </span>
                </div>
                
                <!-- Chat messages area -->
                <div class="card-body p-0">
                    <div class="chat-box" id="chat-log-container">
                        <div class="welcome-message text-center p-4">
                            <h5>Welcome to FreeYap!</h5>
                            <p>You can chat here once you're connected to a partner.</p>
                        </div>
                    </div>                      

                    <!-- Chat input area -->                    
                    <div class="input-group p-3 border-top input-group-container">

                        <!-- Emoji Button -->
                        <div class="input-group-prepend">
                            <button class="btn btn-secondary" id="emoji-button" disabled>
                                <i class="bi bi-emoji-smile"></i>
                            </button>
                        </div>
                        
                        <!-- Custom Popup with Tabs -->                        
                            <div id="custom-popup" style="display:none;">
                            <!-- Tab Headers -->
                            <div class="tab-headers">
                                <button class="tab-btn active" data-tab="emojis" title="Emojis">
                                    <i class="bi bi-emoji-smile"></i>
                                </button>
                                <button class="tab-btn" data-tab="gifs" title="GIFs">
                                    <i class="bi bi-film"></i>
                                </button>
                                <button class="tab-btn" data-tab="stickers" title="Stickers">
                                    <i class="bi bi-sticky"></i>
                                </button>
                                <button class="tab-btn" data-tab="games" title="Games">
                                    <i class="bi bi-controller"></i>
                                </button>
                                <!-- Utilities tab hidden for now -->
                                <button class="tab-btn" data-tab="utilities" title="Utilities" style="display:none;">
                                    <i class="bi bi-tools"></i>
                                </button>
                            </div>
                            
                            <!-- Tab Content -->
                            <div class="tab-content">

                                <!-- Emojis Tab -->
                                <div id="emojis-tab" class="tab-pane active">
                                    <div id="emoji-picker-container"></div>
                                </div>

                                <!-- GIFs Tab -->
                                <div id="gifs-tab" class="tab-pane scrollable_div tab-pane-with-padding">
                                    <input type="text" id="gif-search-bar" placeholder="Search gifs...">
                                    <div id="gif-container"></div>
                                </div>

                                  <!-- Stickers Tab -->
                                <div id="stickers-tab" class="tab-pane scrollable_div tab-pane-with-padding">
                                    <input type="text" id="sticker-search-bar" placeholder="Search stickers...">
                                    <div id="sticker-container"></div>
                                </div>

                                <!-- Games Tab -->
                                <div id="games-tab" class="tab-pane scrollable_div tab-pane-with-padding">
                                    <input type="text" id="game-search-bar" placeholder="Search games...">
                                    <div id="game-container"></div>
                                </div>
                                
                                <!-- Utilities Tab -->
                                <div id="utilities-tab" class="tab-pane tab-pane-utilities">
                                    <div class="utilities-grid">                                        <div class="utility-item" data-utility="photo">
                                            <i class="bi bi-camera utility-icon"></i>
                                            <span class="utility-text">Take Photo</span>
                                        </div>
                                        <div class="utility-item" data-utility="video">
                                            <i class="bi bi-camera-video utility-icon"></i>
                                            <span class="utility-text">Record Video</span>
                                        </div>
                                        <div class="utility-item" data-utility="audio">
                                            <i class="bi bi-mic utility-icon"></i>
                                            <span class="utility-text">Record Audio</span>
                                        </div>
                                        <div class="utility-item" data-utility="upload">
                                            <i class="bi bi-upload utility-icon"></i>
                                            <span class="utility-text">Upload File</span>
                                        </div>
                                        <div class="utility-item" data-utility="poll">
                                            <i class="bi bi-bar-chart utility-icon"></i>
                                            <span class="utility-text">Create Poll</span>
                                        </div>
                                        <div class="utility-item" data-utility="whiteboard">
                                            <i class="bi bi-pencil-square utility-icon"></i>
                                            <span class="utility-text">Whiteboard</span>
                                        </div>
                                    </div>
                                </div>

                            </div>                        
                        </div>    

                        <input type="text" id="chat-input" class="form-control" placeholder="Type a message..." disabled>
                        <div class="input-group-append">
                            <button class="btn btn-primary" id="send-button" disabled>
                                <i class="bi bi-send-fill"></i>
                            </button>
                        </div>
                    </div>

                </div>
            </div>        
        </div>    
    </div>
</div>

<script src="/js/widgets/textChatWidget.js"></script>
<script src="/js/apiClients/giphyAPIClient.js"></script>
<script src="/js/apiClients/gamesAPIClient.js"></script>

<script type="module" src="https://cdn.jsdelivr.net/npm/emoji-picker-element@1/index.js"></script>